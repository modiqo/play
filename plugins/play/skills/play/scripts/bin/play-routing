#!/usr/bin/env python3
"""Manage Play user and project routing policy."""

from __future__ import annotations

import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "scripts" / "lib"))

from play.python_environment import ensure_runtime

ensure_runtime("play-routing", ROOT, Path(__file__).resolve(), sys.argv[1:])

from play.routing import main


if __name__ == "__main__":
    raise SystemExit(main())
