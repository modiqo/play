#!/usr/bin/env python3
"""Thin entrypoint for the structural sidekick interceptor."""

from __future__ import annotations

import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "scripts" / "lib"))

from play.hook_runtime import WORKER_ARGUMENT, run_hook


if __name__ == "__main__":
    if sys.argv[1:2] == [WORKER_ARGUMENT]:
        from play.intercept import main

        raise SystemExit(main(sys.argv[2:]))
    raise SystemExit(run_hook(Path(__file__).resolve(), ROOT, sys.argv[1:]))
