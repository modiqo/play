#!/usr/bin/env python3
"""Execute and benchmark the typed Play controller kernel."""

from __future__ import annotations

import argparse
import importlib.util
import json
import os
import shutil
import statistics
import sys
import tempfile
import time
from dataclasses import asdict
from pathlib import Path
from typing import Any


ROOT = Path(__file__).resolve().parents[2]
if importlib.util.find_spec("statemachine") is None:
    uv = shutil.which("uv")
    if uv is None or os.environ.get("PLAY_MACHINE_UV_BOOTSTRAPPED") == "1":
        raise SystemExit(
            "play-machine requires uv or the pinned Play Python environment"
        )
    environment = os.environ.copy()
    environment["PLAY_MACHINE_UV_BOOTSTRAPPED"] = "1"
    os.execve(
        uv,
        [
            uv,
            "run",
            "--project",
            str(ROOT),
            str(Path(__file__).resolve()),
            *sys.argv[1:],
        ],
        environment,
    )
sys.path.insert(0, str(ROOT / "scripts" / "lib"))

from play.controller import (
    ControllerRuntime,
    ControllerRuntimeError,
    RuntimeSession,
    cursor_from_dict,
    decode_session,
    encode_session,
    event_from_dict,
    session_from_dict,
)
from play.runtime_actions import advance_until_yield
from play.continuations import (
    create as create_continuation,
    discard as discard_continuation,
    load as load_continuation,
    save as save_continuation,
)
from play.private_store import PrivateStoreError
from play.preflight import inspect as inspect_preflight


def _read_object() -> dict[str, Any]:
    try:
        payload = json.load(sys.stdin)
    except json.JSONDecodeError as error:
        raise ControllerRuntimeError(f"stdin is not valid JSON: {error}") from error
    if not isinstance(payload, dict):
        raise ControllerRuntimeError("stdin must contain a JSON object")
    return payload


def _percentile(values: list[int], percentile: float) -> int:
    ordered = sorted(values)
    index = round((len(ordered) - 1) * percentile)
    return ordered[index]


def _continuation_session(
    request: dict[str, Any],
) -> tuple[RuntimeSession | None, str | None]:
    continuation_id = request.get("continuation_id")
    if isinstance(continuation_id, str) and continuation_id:
        return load_continuation(continuation_id), continuation_id
    session_token = request.get("session_token")
    if isinstance(session_token, str) and session_token:
        return decode_session(session_token), None
    return None, None


def _persist_continuation(
    session: RuntimeSession, continuation_id: str | None, *, terminal: bool
) -> str | None:
    if terminal:
        if continuation_id is not None:
            discard_continuation(continuation_id)
        return None
    if continuation_id is None:
        return create_continuation(session)
    save_continuation(continuation_id, session)
    return continuation_id


def _maybe_warm_inbox() -> None:
    """Self-healing catalog warm-up at runtime entry, covering every trajectory.

    The staleness check is one stat call; the refresh is detached and quiet. A
    signed-out machine fails the refresh silently and simply retries on the
    next invocation after login — no trajectory-specific hook can be missed.
    """

    if os.environ.get("PLAY_SKIP_CACHE_WARMUP") == "1":
        return
    try:
        sys.path.insert(0, str(ROOT / "scripts" / "lib"))
        from play.state_home import state_path

        cache = state_path("inbox-cache.json")
        if cache.exists() and time.time() - cache.stat().st_mtime < 6 * 3600:
            return
        refresher = ROOT / "scripts" / "bin" / "play-inbox"
        if not refresher.is_file():
            return
        import subprocess

        subprocess.Popen(
            [sys.executable, str(refresher), "refresh", "--if-older-than", "6"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
    except Exception:  # noqa: BLE001 - warm-up must never affect the runtime
        pass


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    subparsers = parser.add_subparsers(dest="command", required=True)

    describe = subparsers.add_parser("describe")
    describe.add_argument("--json", action="store_true", dest="as_json")

    start = subparsers.add_parser("start")
    start.add_argument("--run-id", required=True)
    start.add_argument("--task-key", required=True)
    start.add_argument("--json", action="store_true", dest="as_json")

    project = subparsers.add_parser("project")
    project.add_argument("--stdin", action="store_true", required=True)
    project.add_argument("--json", action="store_true", dest="as_json")

    session_start = subparsers.add_parser("session-start")
    session_start.add_argument("--stdin", action="store_true", required=True)
    session_start.add_argument("--json", action="store_true", dest="as_json")

    session_project = subparsers.add_parser("session-project")
    session_project.add_argument("--stdin", action="store_true", required=True)
    session_project.add_argument("--json", action="store_true", dest="as_json")

    session_advance = subparsers.add_parser("session-advance")
    session_advance.add_argument("--stdin", action="store_true", required=True)
    session_advance.add_argument("--json", action="store_true", dest="as_json")

    run_until_yield = subparsers.add_parser("run-until-yield")
    run_until_yield.add_argument("--stdin", action="store_true", required=True)
    run_until_yield.add_argument("--json", action="store_true", dest="as_json")
    run_until_yield.add_argument("--max-actions", type=int, default=32)

    step = subparsers.add_parser("step")
    step.add_argument("--stdin", action="store_true", required=True)
    step.add_argument("--json", action="store_true", dest="as_json")

    advance = subparsers.add_parser("advance")
    advance.add_argument("--stdin", action="store_true", required=True)
    advance.add_argument("--json", action="store_true", dest="as_json")

    benchmark = subparsers.add_parser("benchmark")
    benchmark.add_argument("--iterations", type=int, default=1000)
    benchmark.add_argument("--json", action="store_true", dest="as_json")

    runtime_benchmark = subparsers.add_parser("benchmark-runtime")
    runtime_benchmark.add_argument("--iterations", type=int, default=20)
    runtime_benchmark.add_argument("--json", action="store_true", dest="as_json")

    preflight = subparsers.add_parser("preflight")
    preflight.add_argument(
        "--harness",
        choices=("codex", "claude", "kimi", "cursor", "generic"),
        default="generic",
    )
    preflight.add_argument("--json", action="store_true", dest="as_json")

    args = parser.parse_args()
    if args.command == "run-until-yield":
        _maybe_warm_inbox()
    return_code = 0
    try:
        runtime = ControllerRuntime(ROOT)
        if args.command == "describe":
            payload = {
                "schema": "play.runtime-description/v1",
                "bundle_sha256": runtime.bundle.sha256,
                "states": len(runtime.bundle.states),
                "terminals": sorted(runtime.bundle.terminals),
                "compile_ns": runtime.compile_ns,
            }
        elif args.command == "start":
            cursor = runtime.initial_cursor(run_id=args.run_id, task_key=args.task_key)
            payload = {
                "schema": "play.runtime-start/v1",
                "cursor": asdict(cursor),
                "projection": runtime.project(cursor).as_dict(),
            }
        elif args.command == "project":
            request = _read_object()
            cursor_payload = request.get("cursor", request)
            if not isinstance(cursor_payload, dict):
                raise ControllerRuntimeError("stdin requires a cursor object")
            payload = runtime.project(cursor_from_dict(cursor_payload)).as_dict()
        elif args.command == "session-start":
            request = _read_object()
            run_id = request.get("run_id")
            task_key = request.get("task_key")
            original = request.get("request", {}).get("original") if isinstance(request.get("request"), dict) else None
            if not isinstance(run_id, str) or not run_id:
                raise ControllerRuntimeError("stdin requires a non-empty run_id")
            if not isinstance(task_key, str) or not task_key:
                raise ControllerRuntimeError("stdin requires a non-empty task_key")
            if not isinstance(original, str) or not original:
                raise ControllerRuntimeError(
                    "stdin requires a non-empty request.original"
                )
            session = runtime.initial_session(
                run_id=run_id,
                task_key=task_key,
                request_original=original,
            )
            payload = {
                "schema": "play.runtime-session-start/v1",
                "continuation_id": create_continuation(session),
                "projection": runtime.project_session(session).as_dict(),
            }
        elif args.command == "session-project":
            request = _read_object()
            session, _ = _continuation_session(request)
            if session is None:
                raise ControllerRuntimeError("stdin requires a continuation_id")
            payload = runtime.project_session(session).as_dict()
        elif args.command == "session-advance":
            request = _read_object()
            session, continuation_id = _continuation_session(request)
            event_payload = request.get("event")
            if session is None:
                raise ControllerRuntimeError("stdin requires a continuation_id")
            if not isinstance(event_payload, dict):
                raise ControllerRuntimeError("stdin requires an event object")
            result = runtime.advance_session(
                session, event_from_dict(event_payload)
            )
            terminal = result.session.cursor.state in runtime.bundle.terminals
            payload = {
                "schema": result.schema,
                "continuation_id": _persist_continuation(
                    result.session, continuation_id, terminal=terminal
                ),
                "step": result.step.as_dict(),
                "projection": result.projection.as_dict(),
            }
        elif args.command == "run-until-yield":
            request = _read_object()
            session, continuation_id = _continuation_session(request)
            if session is None:
                run_id = request.get("run_id")
                task_key = request.get("task_key")
                request_record = request.get("request")
                original = request_record.get("original") if isinstance(request_record, dict) else None
                if not isinstance(run_id, str) or not run_id:
                    raise ControllerRuntimeError("stdin requires a non-empty run_id")
                if not isinstance(task_key, str) or not task_key:
                    raise ControllerRuntimeError("stdin requires a non-empty task_key")
                if not isinstance(original, str) or not original:
                    raise ControllerRuntimeError("stdin requires a non-empty request.original")
                session = runtime.initial_session(
                    run_id=run_id,
                    task_key=task_key,
                    request_original=original,
                )
            event_payload = request.get("event")
            if event_payload is not None:
                if not isinstance(event_payload, dict):
                    raise ControllerRuntimeError("event must be an object")
                event = event_from_dict(event_payload)
                if (
                    session.cursor.state == "qualify"
                    and event.id not in {"conversation", "play_excluded", "action_blocked"}
                ):
                    preflight = request.get("preflight")
                    if not isinstance(preflight, dict):
                        raise ControllerRuntimeError("a Play preflight object is required")
                    session = runtime.confirm_preflight(session, preflight)
                session = runtime.advance_session(session, event).session
            yielded = advance_until_yield(
                runtime,
                session,
                root=ROOT,
                max_actions=args.max_actions,
            )
            terminal = yielded.session.cursor.state in runtime.bundle.terminals
            payload = {
                "schema": yielded.schema,
                "continuation_id": _persist_continuation(
                    yielded.session, continuation_id, terminal=terminal
                ),
                "projection": yielded.projection,
                "trace": [asdict(item) for item in yielded.trace],
                "presentations": list(yielded.presentations),
            }
        elif args.command == "step":
            request = _read_object()
            cursor_payload = request.get("cursor")
            event_payload = request.get("event")
            if not isinstance(cursor_payload, dict) or not isinstance(event_payload, dict):
                raise ControllerRuntimeError("stdin requires cursor and event objects")
            payload = runtime.step(
                cursor_from_dict(cursor_payload), event_from_dict(event_payload)
            ).as_dict()
        elif args.command == "advance":
            request = _read_object()
            cursor_payload = request.get("cursor")
            event_payload = request.get("event")
            if not isinstance(cursor_payload, dict) or not isinstance(event_payload, dict):
                raise ControllerRuntimeError("stdin requires cursor and event objects")
            payload = runtime.advance(
                cursor_from_dict(cursor_payload), event_from_dict(event_payload)
            ).as_dict()
        elif args.command == "benchmark":
            if args.iterations < 1:
                raise ControllerRuntimeError("iterations must be at least 1")
            durations = []
            for index in range(args.iterations):
                cursor = runtime.initial_cursor(run_id=f"benchmark-{index}", task_key="benchmark")
                event = event_from_dict(
                    {
                        "id": "ordinary_play_invocation",
                        "payload": {"onboarding": {"classify_ns": 1}},
                    }
                )
                durations.append(runtime.step(cursor, event).timing.step_ns)
            payload = {
                "schema": "play.runtime-benchmark/v1",
                "bundle_sha256": runtime.bundle.sha256,
                "iterations": args.iterations,
                "compile_ns": runtime.compile_ns,
                "step_ns": {
                    "min": min(durations),
                    "median": int(statistics.median(durations)),
                    "p95": _percentile(durations, 0.95),
                    "max": max(durations),
                },
            }
        elif args.command == "benchmark-runtime":
            if args.iterations < 1:
                raise ControllerRuntimeError("iterations must be at least 1")
            durations = []
            projection_bytes = []
            continuation_bytes = []
            with tempfile.TemporaryDirectory() as directory:
                continuation_root = Path(directory) / "continuations"
                for index in range(args.iterations):
                    started = time.perf_counter_ns()
                    session = runtime.initial_session(
                        run_id=f"runtime-benchmark-{index}",
                        task_key="runtime-benchmark",
                        request_original="Review this repository implementation",
                    )
                    yielded = advance_until_yield(runtime, session, root=ROOT)
                    continuation_id = create_continuation(
                        yielded.session, root=continuation_root
                    )
                    durations.append(time.perf_counter_ns() - started)
                    projection_bytes.append(
                        len(json.dumps(yielded.projection, separators=(",", ":")).encode())
                    )
                    continuation_bytes.append(len(continuation_id.encode()))
                    discard_continuation(continuation_id, root=continuation_root)
            payload = {
                "schema": "play.runtime-loop-benchmark/v1",
                "bundle_sha256": runtime.bundle.sha256,
                "iterations": args.iterations,
                "compile_ns": runtime.compile_ns,
                "run_until_yield_ns": {
                    "median": int(statistics.median(durations)),
                    "p95": _percentile(durations, 0.95),
                    "max": max(durations),
                },
                "projection_bytes": int(statistics.median(projection_bytes)),
                "continuation_id_bytes": int(statistics.median(continuation_bytes)),
            }
        else:
            payload = inspect_preflight(args.harness)
            return_code = 0 if payload["ready"] is True else 2
    except (ControllerRuntimeError, PrivateStoreError) as error:
        parser.exit(1, f"play-machine: {error}\n")
    print(json.dumps(payload, indent=2, sort_keys=True))
    return return_code


if __name__ == "__main__":
    raise SystemExit(main())
