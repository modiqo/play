#!/usr/bin/env python3
"""Thin entrypoint for discoverability tag hints derived from the originating request."""

from __future__ import annotations

import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "scripts" / "lib"))

from play.python_environment import ensure_runtime

ensure_runtime("play-tag-hints", ROOT, Path(__file__).resolve(), sys.argv[1:])

from play.tag_hints import main


if __name__ == "__main__":
    raise SystemExit(main())
