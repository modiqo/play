#!/usr/bin/env python3
"""Install Play into every supported harness detected on this machine."""

from __future__ import annotations

import argparse
import importlib.util
import json
import os
import shutil
import subprocess
import sys
import tempfile
import time
from dataclasses import dataclass
from pathlib import Path


ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT))

from scripts.lib.play.preflight import REQUIRED_PLAY_EXECUTABLES
from scripts.lib.play.bootstrap import backup_play_state
from scripts.lib.play.journal_settings import ensure_journal_settings

COPY_MARKER_SCHEMA = "play.portable-install/v1"
OPENCODE_COMMAND_MARKER = "<!-- managed-by: modiqo/play -->"
SUPPORTED_HARNESSES = (
    "codex",
    "claude",
    "kimi",
    "cursor",
    "hermes",
    "opencode",
    "deepseek",
)


class InstallError(RuntimeError):
    """A portable or cross-harness installation failed safely."""


@dataclass(frozen=True)
class Harness:
    name: str
    command: str
    skill_roots: tuple[Path, ...]


def _home() -> Path:
    return Path.home()


def harness_catalog() -> dict[str, Harness]:
    home = _home()
    codex_home = Path(os.environ.get("CODEX_HOME", home / ".codex")).expanduser()
    claude_home = Path(
        os.environ.get("CLAUDE_CONFIG_DIR", home / ".claude")
    ).expanduser()
    kimi_home = Path(os.environ.get("KIMI_CONFIG_DIR", home / ".kimi")).expanduser()
    cursor_home = Path(
        os.environ.get("CURSOR_CONFIG_DIR", home / ".cursor")
    ).expanduser()
    hermes_home = Path(os.environ.get("HERMES_HOME", home / ".hermes")).expanduser()
    opencode_home = Path(
        os.environ.get("OPENCODE_CONFIG_DIR", home / ".config" / "opencode")
    ).expanduser()
    deepseek_home = Path(os.environ.get("DSH_HOME", home / ".dsh")).expanduser()
    shared = Path(os.environ.get("AGENTS_HOME", home / ".agents")).expanduser()
    shared_config = Path(
        os.environ.get("AGENTS_CONFIG_HOME", home / ".config" / "agents")
    ).expanduser()
    return {
        "codex": Harness("codex", "codex", (codex_home / "skills",)),
        "claude": Harness("claude", "claude", (claude_home / "skills",)),
        "kimi": Harness(
            "kimi",
            "kimi",
            (kimi_home / "skills", shared_config / "skills", shared / "skills"),
        ),
        "cursor": Harness("cursor", "cursor", (cursor_home / "skills",)),
        "hermes": Harness("hermes", "hermes", (hermes_home / "skills",)),
        "opencode": Harness(
            "opencode", "opencode", (opencode_home / "skills", shared / "skills")
        ),
        "deepseek": Harness(
            "deepseek", "dsh", (deepseek_home / "skills", shared / "skills")
        ),
    }


def selected_harnesses(
    requested: list[str] | None = None, *, include_all: bool = False
) -> list[Harness]:
    catalog = harness_catalog()
    override = os.environ.get("PLAY_INSTALL_HARNESSES")
    if requested and override is not None:
        raise InstallError("use either --harness or PLAY_INSTALL_HARNESSES, not both")
    if requested and include_all:
        raise InstallError("use either --harness or --all-harnesses, not both")
    if include_all:
        names = list(SUPPORTED_HARNESSES)
    elif requested:
        names = requested
    elif override is not None:
        names = [item.strip().lower() for item in override.split(",") if item.strip()]
        if not names:
            raise InstallError("PLAY_INSTALL_HARNESSES is set but empty")
    else:
        names = [
            name
            for name in SUPPORTED_HARNESSES
            if shutil.which(catalog[name].command)
            or any(root_has_rote_provider(root) for root in catalog[name].skill_roots)
        ]
    unknown = sorted(set(names) - set(catalog))
    if unknown:
        raise InstallError("unsupported harness name(s): " + ", ".join(unknown))
    return [catalog[name] for name in dict.fromkeys(names)]


def package_source() -> Path:
    packaged = ROOT / "plugins" / "play" / "skills" / "play"
    return packaged if packaged.is_dir() else ROOT


def version(source: Path) -> str:
    path = source / "VERSION"
    try:
        value = path.read_text(encoding="utf-8").strip()
    except OSError as error:
        raise InstallError(f"cannot read Play version from {path}: {error}") from error
    if not value or any(character.isspace() for character in value):
        raise InstallError(f"invalid Play version in {path}")
    return value


def install_destination() -> Path:
    override = os.environ.get("PLAY_INSTALL_HOME")
    if override:
        base = Path(override).expanduser()
    else:
        data_home = Path(
            os.environ.get("XDG_DATA_HOME", _home() / ".local" / "share")
        ).expanduser()
        base = data_home / "modiqo" / "play"
    return base.resolve() / "skill"


def validate_source(source: Path) -> None:
    required = (
        source / "SKILL.md",
        source / "VERSION",
        source / "scripts" / "harness" / "play-profile",
    )
    missing = [str(path) for path in required if not path.is_file()]
    for name in REQUIRED_PLAY_EXECUTABLES:
        executable = source / "scripts" / "bin" / name
        if not executable.is_file() or not os.access(executable, os.X_OK):
            missing.append(str(executable))
    if missing:
        raise InstallError("Play install source is incomplete:\n  " + "\n  ".join(missing))


def marker(path: Path) -> dict[str, object] | None:
    marker_path = path / ".play-install.json"
    if not marker_path.is_file():
        return None
    try:
        value = json.loads(marker_path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise InstallError(f"cannot read portable install marker {marker_path}: {error}") from error
    if not isinstance(value, dict) or value.get("schema") != COPY_MARKER_SCHEMA:
        raise InstallError(f"unsupported portable install marker in {marker_path}")
    return value


def atomic_json(path: Path, value: dict[str, object]) -> None:
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    temporary.write_text(
        json.dumps(value, indent=2, sort_keys=True) + "\n", encoding="utf-8"
    )
    temporary.chmod(0o600)
    os.replace(temporary, path)


def stage_portable_copy(source: Path) -> tuple[Path, Path | None]:
    validate_source(source)
    destination = install_destination()
    destination.parent.mkdir(parents=True, exist_ok=True)
    if destination.exists() and (destination.is_symlink() or not destination.is_dir()):
        raise InstallError(f"refusing to replace non-directory install path: {destination}")
    if destination.exists() and marker(destination) is None:
        raise InstallError(f"refusing to replace unmanaged install path: {destination}")

    staged = Path(tempfile.mkdtemp(prefix=".play-stage-", dir=destination.parent))
    backup: Path | None = None
    try:
        shutil.copytree(source, staged, dirs_exist_ok=True, symlinks=False)
        atomic_json(
            staged / ".play-install.json",
            {
                "schema": COPY_MARKER_SCHEMA,
                "version": version(source),
                "source": "portable-copy",
            },
        )
        if destination.exists():
            backup = Path(
                tempfile.mkdtemp(prefix=".play-backup-", dir=destination.parent)
            )
            backup.rmdir()
            destination.rename(backup)
        staged.rename(destination)
    except Exception:
        if staged.exists():
            shutil.rmtree(staged)
        if backup is not None and backup.exists() and not destination.exists():
            backup.rename(destination)
        raise
    return destination, backup


def restore_portable_copy(destination: Path, backup: Path | None) -> None:
    if destination.exists():
        shutil.rmtree(destination)
    if backup is not None and backup.exists():
        backup.rename(destination)


def finish_portable_copy(backup: Path | None) -> None:
    if backup is not None and backup.exists():
        shutil.rmtree(backup)


def run_profile(source: Path, command: str, harnesses: list[Harness]) -> None:
    validate_source(source)
    environment = os.environ.copy()
    environment["PLAY_PROFILE_SOURCE"] = str(source.resolve())
    if command == "install":
        # An approved install is the convergence boundary: the complete current
        # Play package replaces prior Play-owned links/profile state after the
        # installer layer has taken its durable backup.
        environment["PLAY_PROFILE_OVERWRITE"] = "1"
    environment["PLAY_HARNESS_ROOTS"] = os.pathsep.join(
        str(root)
        for harness in harnesses
        for root in harness.skill_roots
        if root_has_rote_provider(root)
    )
    if command == "plan":
        environment["PLAY_PROFILE_VERBOSE"] = "1"
    result = subprocess.run(
        [str(source / "scripts" / "harness" / "play-profile"), command],
        cwd=source,
        env=environment,
        check=False,
    )
    if result.returncode:
        raise InstallError(f"Play activation profile {command} failed")


def play_path_for(harness: Harness, source: Path) -> Path | None:
    expected = source.resolve()
    for root in harness.skill_roots:
        candidate = root / "play"
        try:
            if candidate.is_symlink() and candidate.resolve() == expected:
                return candidate
        except OSError:
            continue
    return None


def root_has_rote_provider(root: Path) -> bool:
    try:
        children = root.iterdir()
    except OSError:
        return False
    return any(
        (child.name == "rote" or child.name.startswith("rote-"))
        and (child / "SKILL.md").is_file()
        for child in children
    )


def verify_harness_prerequisites(harnesses: list[Harness]) -> None:
    missing = [
        harness.name
        for harness in harnesses
        if not any(root_has_rote_provider(root) for root in harness.skill_roots)
    ]
    if missing:
        raise InstallError(
            "the Rote skill provider is missing from detected harness(es): "
            + ", ".join(missing)
            + ". Install rote-onboard there with the harness's rote-setup instructions, "
            "then retry this same target selection."
        )


def verify_harness_coverage(harnesses: list[Harness], source: Path) -> None:
    missing = [
        harness.name
        for harness in harnesses
        if play_path_for(harness, source) is None
    ]
    if missing:
        raise InstallError(
            "Play was not installed for detected harness(es): "
            + ", ".join(missing)
            + ". Install the Rote skill provider in those harnesses, then retry."
        )
    for harness in harnesses:
        path = play_path_for(harness, source)
        print(f"  {harness.name}: {path}")


def install_python_dependencies(source: Path) -> None:
    """Materialize the locked runtime environment before exposing Play's launchers."""

    uv = shutil.which("uv")
    if uv is None:
        missing = [
            module
            for module in ("jsonschema", "statemachine", "yaml")
            if importlib.util.find_spec(module) is None
        ]
        if missing:
            raise InstallError(
                "Play needs uv to install its locked Python dependencies "
                f"(missing: {', '.join(missing)})"
            )
        print("  Python dependencies: using the current environment")
        return

    result = subprocess.run(
        [
            uv,
            "sync",
            "--locked",
            "--no-dev",
            "--inexact",
            "--project",
            str(source),
        ],
        cwd=source,
        text=True,
        capture_output=True,
        check=False,
    )
    if result.returncode:
        reason = (result.stderr or result.stdout).strip() or "uv sync failed"
        raise InstallError(f"cannot install Play's locked Python dependencies: {reason}")
    print(f"  Python dependencies: {source / '.venv'}")


def verify_play_runtime(source: Path) -> None:
    validate_source(source)
    launcher = Path(
        os.environ.get("PLAY_MACHINE_LAUNCHER", _home() / ".local" / "bin" / "play-machine")
    ).expanduser().resolve()
    if not launcher.is_file() or not os.access(launcher, os.X_OK):
        raise InstallError(f"Play runtime launcher is missing or not executable: {launcher}")
    expected = source / "scripts" / "bin" / "play-machine"
    try:
        content = launcher.read_text(encoding="utf-8")
    except OSError as error:
        raise InstallError(f"cannot read Play runtime launcher {launcher}: {error}") from error
    if str(expected) not in content:
        raise InstallError(f"Play runtime launcher does not point at the installed skill: {launcher}")
    journey_launcher = Path(
        os.environ.get("PLAY_JOURNEY_LAUNCHER", _home() / ".local" / "bin" / "play-journey")
    ).expanduser().resolve()
    if not journey_launcher.is_file() or not os.access(journey_launcher, os.X_OK):
        raise InstallError(
            f"Play Journey launcher is missing or not executable: {journey_launcher}"
        )
    expected_journey = source / "scripts" / "bin" / "play-journey"
    try:
        journey_content = journey_launcher.read_text(encoding="utf-8")
    except OSError as error:
        raise InstallError(
            f"cannot read Play Journey launcher {journey_launcher}: {error}"
        ) from error
    if str(expected_journey) not in journey_content:
        raise InstallError(
            f"Play Journey launcher does not point at the installed skill: {journey_launcher}"
        )
    cli_launcher = Path(
        os.environ.get("PLAY_CLI_LAUNCHER", _home() / ".local" / "bin" / "play")
    ).expanduser().resolve()
    if not cli_launcher.is_file() or not os.access(cli_launcher, os.X_OK):
        raise InstallError(f"Play CLI launcher is missing or not executable: {cli_launcher}")
    expected_cli = source / "scripts" / "bin" / "play"
    try:
        cli_content = cli_launcher.read_text(encoding="utf-8")
    except OSError as error:
        raise InstallError(f"cannot read Play CLI launcher {cli_launcher}: {error}") from error
    if str(expected_cli) not in cli_content:
        raise InstallError(
            f"Play CLI launcher does not point at the installed skill: {cli_launcher}"
        )
    required_modules = ("jsonschema", "statemachine", "yaml")
    if (
        any(importlib.util.find_spec(module) is None for module in required_modules)
        and shutil.which("uv") is None
    ):
        raise InstallError(
            "Play needs uv or an environment containing its pinned Python dependencies"
        )
    print(
        f"  runtime: {launcher} (Python launcher; {len(REQUIRED_PLAY_EXECUTABLES)} bundled entrypoints verified)"
    )
    print(f"  journey: {journey_launcher}")
    print(f"  cli: {cli_launcher}")


def opencode_command_path() -> Path:
    config = Path(
        os.environ.get("OPENCODE_CONFIG_DIR", _home() / ".config" / "opencode")
    ).expanduser()
    return config / "commands" / "play.md"


def install_opencode_command() -> None:
    path = opencode_command_path()
    content = (
        "---\n"
        "description: Find, run, and save reusable procedures with Play\n"
        "---\n\n"
        f"{OPENCODE_COMMAND_MARKER}\n"
        "Load the `play` skill with the native skill tool, then handle this exact request through Play:\n\n"
        "$ARGUMENTS\n"
    )
    path.parent.mkdir(parents=True, exist_ok=True)
    if path.is_file():
        existing = path.read_text(encoding="utf-8")
        if existing == content:
            print(f"  opencode command: {path} (current)")
            return
        if OPENCODE_COMMAND_MARKER not in existing:
            backup = path.with_name("play.md.pre-play-backup")
            index = 1
            while backup.exists():
                backup = path.with_name(f"play.md.pre-play-backup-{index}")
                index += 1
            shutil.copy2(path, backup)
            print(f"  opencode command backup: {backup}")
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    temporary.write_text(content, encoding="utf-8")
    os.replace(temporary, path)
    print(f"  opencode command: {path} (installed)")


def verify_harness_integrations(harnesses: list[Harness]) -> None:
    if not any(harness.name == "opencode" for harness in harnesses):
        return
    path = opencode_command_path()
    try:
        content = path.read_text(encoding="utf-8")
    except OSError as error:
        raise InstallError(f"OpenCode /play command is missing: {path}: {error}") from error
    if OPENCODE_COMMAND_MARKER not in content:
        raise InstallError(f"OpenCode /play command is not managed by Play: {path}")


def target_payload() -> dict[str, object]:
    targets = []
    for harness in harness_catalog().values():
        rote_roots = [
            str(root) for root in harness.skill_roots if root_has_rote_provider(root)
        ]
        play_roots = [
            str(root)
            for root in harness.skill_roots
            if (root / "play" / "SKILL.md").is_file()
        ]
        command = shutil.which(harness.command)
        targets.append(
            {
                "id": harness.name,
                "label": {
                    "codex": "Codex",
                    "claude": "Claude Code",
                    "kimi": "Kimi",
                    "cursor": "Cursor",
                    "hermes": "Hermes Agent",
                    "opencode": "OpenCode",
                    "deepseek": "DeepSeek Harness (preview)",
                }[harness.name],
                "harness_command": command,
                "skill_roots": [str(root) for root in harness.skill_roots],
                "rote_skills_installed": bool(rote_roots),
                "rote_skill_roots": rote_roots,
                "play_skill_installed": bool(play_roots),
                "play_skill_roots": play_roots,
                "selected": command is not None or bool(rote_roots) or bool(play_roots),
            }
        )
    return {
        "schema": "play.install-targets/v1",
        "selection": "multiple",
        "question": "Install the current Play skill in which harnesses?",
        "targets": targets,
        "command_template": "scripts/harness/install-all install --harness <id> [--harness <id> ...]",
    }


def render_targets(payload: dict[str, object]) -> None:
    print(str(payload["question"]))
    targets = payload["targets"]
    if not isinstance(targets, list):
        raise InstallError("install target payload is malformed")
    for target in targets:
        if not isinstance(target, dict):
            raise InstallError("install target payload is malformed")
        marker = "x" if target["selected"] else " "
        rote = "Rote ready" if target["rote_skills_installed"] else "needs rote-setup"
        installed = "Play installed" if target["play_skill_installed"] else "Play not installed"
        print(f"  [{marker}] {target['label']} ({target['id']}): {rote}; {installed}")
    print("Select explicitly with repeated --harness flags, or use --all-harnesses.")


def execute(
    command: str,
    *,
    copy_install: bool,
    requested_harnesses: list[str] | None = None,
    include_all: bool = False,
    prepared_backup: Path | None = None,
) -> None:
    harnesses = selected_harnesses(requested_harnesses, include_all=include_all)
    if not harnesses:
        raise InstallError(
            "no supported harness command was detected; use --harness to select one explicitly"
        )
    print(
        "Detected harnesses: " + ", ".join(item.name for item in harnesses),
        flush=True,
    )
    verify_harness_prerequisites(harnesses)

    if command == "plan":
        run_profile(ROOT, "plan", harnesses)
        return

    if command == "install":
        if prepared_backup is not None:
            try:
                prepared = json.loads(prepared_backup.read_text(encoding="utf-8"))
            except (OSError, json.JSONDecodeError) as error:
                raise InstallError(
                    f"cannot use prepared Play backup {prepared_backup}: {error}"
                ) from error
            expected_harnesses = [harness.name for harness in harnesses]
            if (
                not isinstance(prepared, dict)
                or prepared.get("schema") != "play.install-backup/v1"
                or prepared.get("selected_harnesses") != expected_harnesses
            ):
                raise InstallError(
                    f"prepared Play backup does not cover this install: {prepared_backup}"
                )
            backup_manifest = prepared_backup
        else:
            targets = {
                harness.name: {
                    "skill_roots": [str(root) for root in harness.skill_roots]
                }
                for harness in harnesses
            }
            backup_manifest = backup_play_state(
                [harness.name for harness in harnesses],
                targets,
                run_id=f"install-all-{time.time_ns()}-{os.getpid()}",
            )
        print(f"Play state backup: {backup_manifest}")

    source = ROOT
    destination: Path | None = None
    backup: Path | None = None
    profile_activated = False
    if copy_install:
        destination, backup = stage_portable_copy(package_source())
        source = destination
    try:
        if command == "install":
            install_python_dependencies(source)
        run_profile(source, "install" if command == "install" else "verify", harnesses)
        profile_activated = command == "install"
        if command == "install" and any(item.name == "opencode" for item in harnesses):
            install_opencode_command()
        verify_harness_coverage(harnesses, source)
        verify_harness_integrations(harnesses)
        verify_play_runtime(source)
        if command == "install":
            initialize_routing_policy(source)
            initialize_journals()
    except Exception:
        if destination is not None:
            if profile_activated:
                # The activation profile and launcher now own this stable source path.
                # Retain it so a later verification failure cannot create a stale launcher.
                finish_portable_copy(backup)
            else:
                restore_portable_copy(destination, backup)
        raise
    finish_portable_copy(backup)
    if command == "install":
        warm_inbox_cache(source)
        print(
            f"Play {version(source)} is ready. Restart each running harness and use its invocation shown in the final setup card."
        )


def initialize_routing_policy(source: Path) -> None:
    """Create the owner-private routing policy without touching the caller's project."""

    command = source / "scripts" / "bin" / "play-routing"
    result = subprocess.run(
        [str(command), "--user", "init"],
        cwd=source,
        text=True,
        capture_output=True,
        check=False,
        timeout=30,
    )
    if result.returncode:
        reason = (result.stderr or result.stdout).strip() or "routing initialization failed"
        raise InstallError(reason)
    message = result.stdout.strip()
    if message:
        print(f"Play routing policy {message}")


def initialize_journals() -> None:
    """Enable sparse exploration pulses and private recall history by default."""

    settings, changed = ensure_journal_settings()
    exploration = settings["exploration"]
    recall = settings["recall"]
    state = "initialized" if changed else "current"
    exploration_state = (
        f"every {exploration['interval_steps']} steps "
        f"(at most every {exploration['min_interval_seconds']}s)"
        if settings["enabled"] and exploration["enabled"]
        else "off"
    )
    recall_state = "on" if settings["enabled"] and recall["enabled"] else "off"
    print(
        "Play journals "
        f"{state}: exploration {exploration_state}; recall history {recall_state}."
    )


def warm_inbox_cache(source: Path) -> None:
    """Best-effort background warm-up of the zero-token inbox and hub catalog.

    Detached and quiet: without an installed, authenticated Rote the refresh
    simply fails silently and the interceptor/inbox stay empty until the next
    session-start refresh after setup. Never blocks or fails installation.
    """

    refresher = source / "scripts" / "bin" / "play-inbox"
    if not refresher.is_file():
        return
    try:
        subprocess.Popen(
            [sys.executable, str(refresher), "refresh", "--if-older-than", "6"],
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
            start_new_session=True,
        )
        print("Warming the Play inbox and hub catalog cache in the background.")
    except OSError:
        pass


def main(argv: list[str] | None = None) -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("command", choices=("targets", "plan", "install", "verify"))
    parser.add_argument(
        "--copy",
        action="store_true",
        help="copy the packaged skill to a stable user data directory before activation",
    )
    parser.add_argument(
        "--harness",
        action="append",
        choices=SUPPORTED_HARNESSES,
        dest="harnesses",
        help="install/verify one target; repeat to make a multi-select choice",
    )
    parser.add_argument(
        "--all-harnesses",
        action="store_true",
        help="target every supported harness, including ones whose command is not on PATH",
    )
    parser.add_argument(
        "--prepared-backup",
        type=Path,
        help=argparse.SUPPRESS,
    )
    parser.add_argument("--json", action="store_true", help="emit machine-readable target choices")
    args = parser.parse_args(argv)
    if args.copy and args.command != "install":
        parser.error("--copy is available only with install")
    if args.prepared_backup is not None and args.command != "install":
        parser.error("--prepared-backup is available only with install")
    if args.command == "targets":
        if args.harnesses or args.all_harnesses or args.copy:
            parser.error("targets does not accept install selection flags")
        payload = target_payload()
        print(json.dumps(payload, indent=2, sort_keys=True) if args.json else "", end="")
        if not args.json:
            render_targets(payload)
        elif args.json:
            print()
        return 0
    if args.json:
        parser.error("--json is available only with targets")
    try:
        execute(
            args.command,
            copy_install=args.copy,
            requested_harnesses=args.harnesses,
            include_all=args.all_harnesses,
            prepared_backup=args.prepared_backup,
        )
    except (InstallError, OSError) as error:
        print(f"install-all: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
