#!/usr/bin/env python3
"""Install and restore the Play-first skill activation profile."""

from __future__ import annotations

import argparse
import base64
import copy
import hashlib
import json
import os
import re
import stat
import sys
from pathlib import Path


SCHEMA = "play.activation-profile/v1"
ACTIVATION_POLICY = "rote-handoff-invocable/v1"
PORTABLE_MARKER_SCHEMA = "play.portable-install/v1"
SOURCE = Path(
    os.environ.get("PLAY_PROFILE_SOURCE", Path(__file__).resolve().parents[2])
).expanduser().resolve()


class ProfileError(RuntimeError):
    pass


def state_path() -> Path:
    override = os.environ.get("PLAY_PROFILE_STATE")
    if override:
        return Path(override).expanduser().resolve()
    state_home = Path(os.environ.get("XDG_STATE_HOME", Path.home() / ".local" / "state"))
    return state_home / "play-skill" / "activation-profile.json"


def launcher_path() -> Path:
    override = os.environ.get("PLAY_MACHINE_LAUNCHER")
    if override:
        return Path(override).expanduser().resolve()
    return Path.home() / ".local" / "bin" / "play-machine"


def launcher_content() -> bytes:
    executable = SOURCE / "scripts" / "bin" / "play-machine"
    return f'#!/bin/sh\nexec "{executable}" "$@"\n'.encode()


def routing_launcher_path() -> Path:
    override = os.environ.get("PLAY_ROUTING_LAUNCHER")
    if override:
        return Path(override).expanduser().resolve()
    return Path.home() / ".local" / "bin" / "play-routing"


def routing_launcher_content() -> bytes:
    executable = SOURCE / "scripts" / "bin" / "play-routing"
    return f'#!/bin/sh\nexec "{executable}" "$@"\n'.encode()


def journey_launcher_path() -> Path:
    override = os.environ.get("PLAY_JOURNEY_LAUNCHER")
    if override:
        return Path(override).expanduser().resolve()
    return Path.home() / ".local" / "bin" / "play-journey"


def journey_launcher_content() -> bytes:
    executable = SOURCE / "scripts" / "bin" / "play-journey"
    return f'#!/bin/sh\nexec "{executable}" "$@"\n'.encode()


def managed_launchers() -> tuple[tuple[Path, bytes], ...]:
    return (
        (launcher_path(), launcher_content()),
        (routing_launcher_path(), routing_launcher_content()),
        (journey_launcher_path(), journey_launcher_content()),
    )


def configured_roots() -> list[Path] | None:
    value = os.environ.get("PLAY_HARNESS_ROOTS")
    if value is None:
        return None
    roots = [Path(item).expanduser().resolve() for item in value.split(os.pathsep) if item]
    if not roots:
        raise ProfileError("PLAY_HARNESS_ROOTS is set but empty")
    return roots


def iter_rote_skills(root: Path):
    try:
        children = root.iterdir()
    except OSError:
        return
    for child in children:
        if child.name == "rote" or child.name.startswith("rote-"):
            if (child / "SKILL.md").is_file():
                yield child


def discover_roots(
    *, include_plugin_caches: bool | None = None, require_roots: bool = True
) -> list[Path]:
    configured = configured_roots()
    candidates: set[Path] = set(configured or [])

    if configured is None:
        home = Path.home()
        candidates.update(home.glob(".*/skills"))
        candidates.update(home.glob(".*/agent/skills"))
        candidates.update(home.glob(".*/data/skills"))
        candidates.update((home / ".config").glob("*/skills"))
        if include_plugin_caches is None:
            include_plugin_caches = marketplace_source()
        if include_plugin_caches:
            candidates.update(
                (home / ".codex" / "plugins" / "cache").glob("*/*/*/skills")
            )
            candidates.update(
                (home / ".codex" / ".tmp" / "marketplaces").glob(
                    "*/plugins/*/skills"
                )
            )
            candidates.update(
                (home / ".claude" / "plugins" / "cache").glob("*/*/*/skills")
            )

        for variable, suffix in (
            ("CODEX_HOME", "skills"),
            ("CLAUDE_CONFIG_DIR", "skills"),
            ("AUTOHAND_HOME", "skills"),
            ("HERMES_HOME", "skills"),
            ("VIBE_HOME", "skills"),
        ):
            if value := os.environ.get(variable):
                candidates.add(Path(value).expanduser() / suffix)

    roots = []
    for root in sorted(candidates, key=lambda item: str(item)):
        if root.is_dir() and any(iter_rote_skills(root)):
            roots.append(root.resolve())
    roots = list(dict.fromkeys(roots))
    if not roots and require_roots:
        raise ProfileError(
            "no harness skill roots containing rote skills were found; "
            "run rote harness setup --yes or set PLAY_HARNESS_ROOTS"
        )
    return roots


def marketplace_source() -> bool:
    """Return whether Play is already delivered by a harness plugin."""
    return any(
        (ancestor / marker / "plugin.json").is_file()
        for ancestor in (SOURCE, *SOURCE.parents)
        for marker in (".codex-plugin", ".claude-plugin", ".cursor-plugin", ".kimi-plugin")
    )


def is_portable_source(source: Path) -> bool:
    """Return whether ``source`` was staged by Play's portable installer."""
    marker = source / ".play-install.json"
    if not marker.is_file() or marker.is_symlink():
        return False
    try:
        payload = json.loads(marker.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError):
        return False
    return (
        isinstance(payload, dict)
        and payload.get("schema") == PORTABLE_MARKER_SCHEMA
        and payload.get("source") == "portable-copy"
        and isinstance(payload.get("version"), str)
        and bool(payload["version"].strip())
    )


def portable_source() -> bool:
    """Return whether the requested source is a managed portable copy."""
    return is_portable_source(SOURCE)


def overwrite_requested() -> bool:
    """Return whether an approved installer requested full Play convergence."""

    return os.environ.get("PLAY_PROFILE_OVERWRITE") == "1"


def remove_path(path: Path) -> None:
    if path.is_symlink() or path.is_file():
        path.unlink()
    elif path.is_dir():
        import shutil

        shutil.rmtree(path)


def displace_paths(paths: list[Path]) -> dict[Path, Path]:
    """Move conflicting Play paths aside until the profile transaction commits."""

    displaced: dict[Path, Path] = {}
    for path in paths:
        if not path.exists() and not path.is_symlink():
            continue
        staged = path.with_name(f".{path.name}.play-overwrite-{os.getpid()}")
        if staged.exists() or staged.is_symlink():
            raise ProfileError(f"refusing unsafe overwrite staging path: {staged}")
        path.rename(staged)
        displaced[path] = staged
    return displaced


def discard_displaced(displaced: dict[Path, Path]) -> None:
    for staged in displaced.values():
        if staged.exists() or staged.is_symlink():
            remove_path(staged)


def restore_displaced(displaced: dict[Path, Path]) -> None:
    for original, staged in reversed(list(displaced.items())):
        if not staged.exists() and not staged.is_symlink():
            continue
        if original.exists() or original.is_symlink():
            remove_path(original)
        staged.rename(original)


def read_bytes(path: Path) -> bytes:
    try:
        return path.read_bytes()
    except OSError as error:
        raise ProfileError(f"cannot read {path}: {error}") from error


def digest(content: bytes) -> str:
    return hashlib.sha256(content).hexdigest()


def atomic_write(path: Path, content: bytes, mode: int = 0o644) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_name(f".{path.name}.{os.getpid()}.tmp")
    try:
        temporary.write_bytes(content)
        temporary.chmod(mode)
        os.replace(temporary, path)
    finally:
        if temporary.exists():
            temporary.unlink()


def snapshot(path: Path) -> dict[str, object]:
    if not path.exists():
        return {"exists": False}
    if not path.is_file() or path.is_symlink():
        raise ProfileError(f"refusing to replace non-regular activation file: {path}")
    return {
        "exists": True,
        "mode": stat.S_IMODE(path.stat().st_mode),
        "content": base64.b64encode(read_bytes(path)).decode("ascii"),
    }


def restore(path: Path, record: dict[str, object]) -> None:
    if record["exists"]:
        content = base64.b64decode(str(record["content"]))
        atomic_write(path, content, int(record["mode"]))
        return
    if path.exists():
        if not path.is_file() or path.is_symlink():
            raise ProfileError(f"refusing to remove unexpected activation path: {path}")
        path.unlink()
    parent = path.parent
    if parent.name == "agents" and parent.is_dir() and not any(parent.iterdir()):
        parent.rmdir()


def invocable_skill_markdown(original: bytes) -> bytes:
    text = original.decode("utf-8")
    lines = text.splitlines(keepends=True)
    if not lines or lines[0].strip() != "---":
        raise ProfileError("SKILL.md has no YAML frontmatter")
    closing = next(
        (index for index, line in enumerate(lines[1:], 1) if line.strip() == "---"),
        None,
    )
    if closing is None:
        raise ProfileError("SKILL.md has unterminated YAML frontmatter")
    frontmatter = [
        line
        for line in lines[1:closing]
        if not re.match(r"^disable-model-invocation\s*:", line)
    ]
    newline = "\r\n" if lines[0].endswith("\r\n") else "\n"
    frontmatter.append(f"disable-model-invocation: false{newline}")
    return "".join(
        [lines[0], *frontmatter, lines[closing], *lines[closing + 1 :]]
    ).encode()


def invocable_openai_yaml(original: bytes | None) -> bytes:
    if original is None:
        return b"policy:\n  allow_implicit_invocation: true\n"

    text = original.decode("utf-8")
    pattern = re.compile(r"(?m)^(\s{2}allow_implicit_invocation:)\s*[^\n]*$")
    if pattern.search(text):
        return pattern.sub(r"\1 true", text).encode()

    lines = text.splitlines(keepends=True)
    policy = next(
        (index for index, line in enumerate(lines) if line.rstrip("\r\n") == "policy:"),
        None,
    )
    newline = "\r\n" if any(line.endswith("\r\n") for line in lines) else "\n"
    if policy is not None:
        lines.insert(policy + 1, f"  allow_implicit_invocation: true{newline}")
        return "".join(lines).encode()
    separator = "" if not text or text.endswith(("\n", "\r")) else newline
    return (
        f"{text}{separator}policy:{newline}"
        f"  allow_implicit_invocation: true{newline}"
    ).encode()


def play_is_implicit() -> bool:
    metadata = read_bytes(SOURCE / "agents" / "openai.yaml").decode("utf-8")
    return bool(
        re.search(r"(?m)^\s{2}allow_implicit_invocation:\s*true\s*$", metadata)
    )


def rote_is_invocable(skill: Path) -> bool:
    markdown = read_bytes(skill / "SKILL.md").decode("utf-8")
    metadata = skill / "agents" / "openai.yaml"
    return (
        bool(re.search(r"(?m)^disable-model-invocation:\s*false\s*$", markdown))
        and metadata.is_file()
        and bool(
            re.search(
                r"(?m)^\s{2}allow_implicit_invocation:\s*true\s*$",
                read_bytes(metadata).decode("utf-8"),
            )
        )
    )


def load_state() -> dict[str, object] | None:
    path = state_path()
    if not path.exists():
        return None
    try:
        state = json.loads(path.read_text())
    except (OSError, json.JSONDecodeError) as error:
        raise ProfileError(f"cannot read activation state {path}: {error}") from error
    if state.get("schema") != SCHEMA:
        raise ProfileError(f"unsupported activation state schema in {path}")
    return state


def backup_profile_state(state: dict[str, object]) -> dict[str, str]:
    """Archive the exact prior profile before transferring source ownership."""
    path = state_path()
    content = read_bytes(path)
    try:
        current = json.loads(content)
    except json.JSONDecodeError as error:
        raise ProfileError(f"cannot back up activation state {path}: {error}") from error
    if current != state:
        raise ProfileError("activation state changed during migration; retry the install")

    backup_root = path.parent / "profile-backups"
    if (backup_root.exists() or backup_root.is_symlink()) and (
        not backup_root.is_dir() or backup_root.is_symlink()
    ):
        raise ProfileError(f"refusing unsafe profile backup path: {backup_root}")
    try:
        backup_root.mkdir(parents=True, exist_ok=True, mode=0o700)
        backup_root.chmod(0o700)
    except OSError as error:
        raise ProfileError(
            f"cannot prepare profile backup path {backup_root}: {error}"
        ) from error

    content_sha256 = digest(content)
    backup = backup_root / f"activation-profile-{content_sha256}.json"
    if backup.exists() or backup.is_symlink():
        if (
            not backup.is_file()
            or backup.is_symlink()
            or read_bytes(backup) != content
        ):
            raise ProfileError(f"refusing to replace changed profile backup: {backup}")
    else:
        try:
            atomic_write(backup, content, 0o600)
        except OSError as error:
            raise ProfileError(
                f"cannot write profile backup {backup}: {error}"
            ) from error

    return {
        "path": str(backup),
        "sha256": content_sha256,
        "source": str(state.get("source", "")),
    }


def verify_state(state: dict[str, object]) -> list[str]:
    problems = []
    source = Path(str(state["source"])).resolve()
    if source != SOURCE:
        problems.append(f"state belongs to another Play source: {source}")
    expected_mode = "marketplace" if marketplace_source() else "source-linked"
    if state.get("mode", "source-linked") != expected_mode:
        problems.append(f"activation mode changed; expected {expected_mode}")
    if not play_is_implicit():
        problems.append("Play source is not configured for implicit invocation")
    launcher = Path(str(state.get("launcher", launcher_path())))
    if not launcher.is_file() or read_bytes(launcher) != launcher_content():
        problems.append(f"missing or changed Play runtime launcher: {launcher}")
    routing_launcher = Path(
        str(state.get("routing_launcher", routing_launcher_path()))
    )
    if (
        not routing_launcher.is_file()
        or read_bytes(routing_launcher) != routing_launcher_content()
    ):
        problems.append(f"missing or changed Play routing launcher: {routing_launcher}")
    journey_launcher = Path(
        str(state.get("journey_launcher", journey_launcher_path()))
    )
    if (
        not journey_launcher.is_file()
        or read_bytes(journey_launcher) != journey_launcher_content()
    ):
        problems.append(f"missing or changed Play Journey launcher: {journey_launcher}")
    try:
        current_roots = {
            str(root)
            for root in discover_roots(
                include_plugin_caches=expected_mode == "marketplace",
                require_roots=expected_mode != "marketplace",
            )
        }
    except ProfileError:
        current_roots = set()
    recorded_roots = set(map(str, state["roots"]))
    if current_roots != recorded_roots:
        problems.append("installed harness roots changed; uninstall and install the profile again")
    for value in state["play_links"]:
        link = Path(str(value))
        if not link.is_symlink() or link.resolve() != source:
            problems.append(f"missing or changed Play link: {link}")
    for value in state["rote_skills"]:
        skill = Path(str(value))
        if not rote_is_invocable(skill):
            problems.append(f"rote skill is not handoff-invocable: {skill}")
    return problems


def desired_profile(mode: str) -> tuple[list[Path], list[Path], dict[Path, Path]]:
    roots = discover_roots(
        include_plugin_caches=mode == "marketplace",
        require_roots=mode != "marketplace",
    )
    play_links = [] if mode == "marketplace" else [root / "play" for root in roots]
    rote_skills: dict[Path, Path] = {}
    for root in roots:
        for visible_path in iter_rote_skills(root):
            rote_skills.setdefault(visible_path.resolve(), visible_path)
    return roots, play_links, rote_skills


def activation_paths(skill: Path) -> tuple[Path, Path]:
    return skill / "SKILL.md", skill / "agents" / "openai.yaml"


def reconcile(state: dict[str, object]) -> None:
    source = Path(str(state["source"])).resolve()
    mode = "marketplace" if marketplace_source() else "source-linked"
    previous_mode = state.get("mode", "source-linked")
    source_changed = source != SOURCE
    recorded_source_available = (source / "SKILL.md").is_file() and (
        source / "scripts" / "bin" / "play-machine"
    ).is_file()
    orphaned_source_restore = source_changed and not recorded_source_available
    portable_destination_migration = (
        source_changed
        and mode == "source-linked"
        and portable_source()
    )
    portable_origin_migration = (
        source_changed
        and mode == "source-linked"
        and is_portable_source(source)
    )
    managed_source_migration = (
        portable_destination_migration or portable_origin_migration
    )
    if source_changed and not (
        orphaned_source_restore
        or (mode == "marketplace" and previous_mode == "marketplace")
        or managed_source_migration
    ):
        raise ProfileError(f"profile state belongs to another Play source: {source}")
    if previous_mode != mode and not (
        orphaned_source_restore or managed_source_migration
    ):
        raise ProfileError(f"activation mode changed; expected {mode}")
    if not play_is_implicit():
        raise ProfileError("Play source is not configured for implicit invocation")

    roots, play_links, rote_skills = desired_profile(mode)
    old_links = [Path(str(value)) for value in state["play_links"]]
    old_link_set = set(old_links)
    desired_link_set = set(play_links)
    overwrite = overwrite_requested()
    displaced: dict[Path, Path] = {}
    invalid_old_links: list[Path] = []
    for link in old_links:
        if link.is_symlink() and link.resolve() in {source, SOURCE}:
            continue
        if not link.exists() and not link.is_symlink():
            continue
        invalid_old_links.append(link)
    conflicts = [
        link
        for link in desired_link_set - old_link_set
        if link.exists() or link.is_symlink()
    ]
    overwrite_conflicts = list(dict.fromkeys([*invalid_old_links, *conflicts]))
    if overwrite_conflicts and not overwrite:
        raise ProfileError(
            "refusing to replace existing Play installs:\n  "
            + "\n  ".join(map(str, overwrite_conflicts))
        )
    if overwrite_conflicts:
        displaced = displace_paths(overwrite_conflicts)

    backups = copy.deepcopy(state["backups"])
    rollback_files: dict[Path, dict[str, object]] = {}
    created_links: list[Path] = []
    removed_links: list[Path] = []
    restored_links: dict[Path, Path | None] = {}
    rebased_skills: set[Path] = set()
    previous_skills = {Path(str(value)) for value in state["rote_skills"]}
    desired_skills = set(rote_skills)
    policy_changed = state.get("activation_policy") != ACTIVATION_POLICY
    launcher = launcher_path()
    recorded_launcher = state.get("launcher")
    if recorded_launcher is not None and Path(str(recorded_launcher)) != launcher:
        raise ProfileError("Play runtime launcher path changed; uninstall before reinstalling")
    routing_launcher = routing_launcher_path()
    recorded_routing_launcher = state.get("routing_launcher")
    if (
        recorded_routing_launcher is not None
        and Path(str(recorded_routing_launcher)) != routing_launcher
    ):
        raise ProfileError("Play routing launcher path changed; uninstall before reinstalling")
    journey_launcher = journey_launcher_path()
    recorded_journey_launcher = state.get("journey_launcher")
    if (
        recorded_journey_launcher is not None
        and Path(str(recorded_journey_launcher)) != journey_launcher
    ):
        raise ProfileError("Play Journey launcher path changed; uninstall before reinstalling")

    profile_backups = copy.deepcopy(state.get("profile_backups", []))
    if not isinstance(profile_backups, list):
        raise ProfileError("activation state has malformed profile backup history")
    profile_backup = None
    if source_changed or previous_mode != mode:
        profile_backup = backup_profile_state(state)
        if not any(
            isinstance(record, dict)
            and record.get("sha256") == profile_backup["sha256"]
            and record.get("path") == profile_backup["path"]
            for record in profile_backups
        ):
            profile_backups.append(profile_backup)

    try:
        for skill in sorted(previous_skills - desired_skills, key=str):
            for path in activation_paths(skill):
                record = backups.pop(str(path), None)
                if record is None or not path.is_file():
                    continue
                if record.get("managed_sha256") != digest(read_bytes(path)):
                    continue
                rollback_files.setdefault(path, snapshot(path))
                restore(path, record)

        for skill in sorted(desired_skills, key=str):
            markdown, metadata = activation_paths(skill)
            for path in (markdown, metadata):
                record = backups.get(str(path))
                managed = record.get("managed_sha256") if record else None
                current_matches = (
                    path.is_file() and managed is not None and managed == digest(read_bytes(path))
                )
                if current_matches and not policy_changed:
                    continue
                rollback_files.setdefault(path, snapshot(path))
                if not current_matches:
                    backups[str(path)] = snapshot(path)
                if path == markdown:
                    content = invocable_skill_markdown(read_bytes(path))
                    mode_bits = path.stat().st_mode & 0o777
                else:
                    content = invocable_openai_yaml(read_bytes(path) if path.exists() else None)
                    mode_bits = 0o644
                atomic_write(path, content, mode_bits)
                backups[str(path)]["managed_sha256"] = digest(read_bytes(path))
                rebased_skills.add(skill)

        launchers_changed = False
        for managed_launcher, content in managed_launchers():
            launcher_record = backups.get(str(managed_launcher))
            launcher_managed = (
                launcher_record.get("managed_sha256") if launcher_record else None
            )
            launcher_matches_managed = (
                managed_launcher.is_file()
                and launcher_managed is not None
                and launcher_managed == digest(read_bytes(managed_launcher))
            )
            if (
                managed_launcher.exists()
                and not launcher_matches_managed
                and launcher_record is None
            ):
                raise ProfileError(
                    f"refusing to replace existing Play launcher: {managed_launcher}"
                )
            changed = (
                not managed_launcher.is_file()
                or read_bytes(managed_launcher) != content
            )
            launchers_changed = launchers_changed or changed
            if changed:
                rollback_files.setdefault(managed_launcher, snapshot(managed_launcher))
                if launcher_record is None:
                    backups[str(managed_launcher)] = snapshot(managed_launcher)
                atomic_write(managed_launcher, content, 0o755)
                backups[str(managed_launcher)]["managed_sha256"] = digest(
                    read_bytes(managed_launcher)
                )

        for link in sorted(old_link_set - desired_link_set, key=str):
            if link.is_symlink():
                link.unlink()
                removed_links.append(link)
        for link in sorted(old_link_set & desired_link_set, key=str):
            if link.is_symlink() and link.resolve() == SOURCE:
                continue
            previous_target = link.readlink() if link.is_symlink() else None
            if link.is_symlink():
                link.unlink()
            link.symlink_to(SOURCE, target_is_directory=True)
            restored_links[link] = previous_target
        for link in sorted(desired_link_set - old_link_set, key=str):
            link.symlink_to(SOURCE, target_is_directory=True)
            created_links.append(link)

        profile_changed = bool(
            rebased_skills
            or launchers_changed
            or source_changed
            or policy_changed
            or restored_links
            or old_link_set != desired_link_set
            or previous_skills != desired_skills
            or list(map(str, roots)) != list(map(str, state["roots"]))
        )
        if not profile_changed:
            print(f"Play-first profile already active across {len(roots)} harness root(s)")
            return

        updated = {
            **state,
            "source": str(SOURCE),
            "activation_policy": ACTIVATION_POLICY,
            "mode": mode,
            "roots": [str(root) for root in roots],
            "play_links": [str(link) for link in play_links],
            "rote_skills": [str(skill) for skill in sorted(desired_skills, key=str)],
            "launcher": str(launcher),
            "routing_launcher": str(routing_launcher),
            "journey_launcher": str(journey_launcher),
            "backups": backups,
            "profile_backups": profile_backups,
        }
        atomic_write(
            state_path(),
            (json.dumps(updated, indent=2, sort_keys=True) + "\n").encode(),
            0o600,
        )
        discard_displaced(displaced)
    except Exception:
        for link in reversed(created_links):
            if link.is_symlink():
                link.unlink()
        for link, previous_target in reversed(list(restored_links.items())):
            if link.is_symlink():
                link.unlink()
            if previous_target is not None:
                link.symlink_to(previous_target, target_is_directory=True)
        for link in removed_links:
            if not link.exists() and not link.is_symlink():
                link.symlink_to(SOURCE, target_is_directory=True)
        for path, record in reversed(list(rollback_files.items())):
            restore(path, record)
        restore_displaced(displaced)
        raise

    print(
        f"reconciled Play-first {mode} profile across {len(roots)} harness root(s); "
        f"rebased {len(rebased_skills)} refreshed/new rote skill(s); "
        f"restored {len(restored_links)} managed Play link(s)"
    )
    if orphaned_source_restore:
        print(f"restored activation from missing Play source: {source}")
    if profile_backup is not None:
        print(f"backed up previous activation profile: {profile_backup['path']}")
    print("restart the harness to reload the reconciled activation profile")


def install() -> None:
    existing = load_state()
    if existing:
        reconcile(existing)
        return
    if not (SOURCE / "SKILL.md").is_file() or not play_is_implicit():
        raise ProfileError("Play source is incomplete or not implicit")

    mode = "marketplace" if marketplace_source() else "source-linked"
    roots, play_links, rote_skills = desired_profile(mode)
    conflicts = [path for path in play_links if path.exists() or path.is_symlink()]
    for managed_launcher, _content in managed_launchers():
        if managed_launcher.exists() or managed_launcher.is_symlink():
            conflicts.append(managed_launcher)
    overwrite = overwrite_requested()
    if conflicts and not overwrite:
        raise ProfileError(
            "refusing to replace existing Play installs:\n  "
            + "\n  ".join(map(str, conflicts))
        )

    displaced = displace_paths(conflicts) if conflicts else {}

    backups: dict[str, dict[str, object]] = {}
    created_links: list[Path] = []
    try:
        for skill in rote_skills:
            markdown = skill / "SKILL.md"
            metadata = skill / "agents" / "openai.yaml"
            backups[str(markdown)] = snapshot(markdown)
            backups[str(metadata)] = snapshot(metadata)
            atomic_write(
                markdown,
                invocable_skill_markdown(read_bytes(markdown)),
                markdown.stat().st_mode & 0o777,
            )
            original_metadata = read_bytes(metadata) if metadata.exists() else None
            atomic_write(metadata, invocable_openai_yaml(original_metadata))

        for value, record in backups.items():
            record["managed_sha256"] = digest(read_bytes(Path(value)))

        for link in play_links:
            link.symlink_to(SOURCE, target_is_directory=True)
            created_links.append(link)

        for managed_launcher, content in managed_launchers():
            backups[str(managed_launcher)] = snapshot(managed_launcher)
            atomic_write(managed_launcher, content, 0o755)
            backups[str(managed_launcher)]["managed_sha256"] = digest(
                read_bytes(managed_launcher)
            )

        state = {
            "schema": SCHEMA,
            "activation_policy": ACTIVATION_POLICY,
            "source": str(SOURCE),
            "mode": mode,
            "roots": [str(root) for root in roots],
            "play_links": [str(link) for link in play_links],
            "rote_skills": [str(skill) for skill in rote_skills],
            "launcher": str(launcher_path()),
            "routing_launcher": str(routing_launcher_path()),
            "journey_launcher": str(journey_launcher_path()),
            "backups": backups,
        }
        atomic_write(
            state_path(),
            (json.dumps(state, indent=2, sort_keys=True) + "\n").encode(),
            0o600,
        )
    except Exception:
        for link in reversed(created_links):
            if link.is_symlink():
                link.unlink()
        for value, record in reversed(list(backups.items())):
            restore(Path(value), record)
        restore_displaced(displaced)
        raise

    discard_displaced(displaced)

    print(
        f"activated Play-first {mode} profile across {len(roots)} harness root(s); "
        f"made {len(rote_skills)} canonical rote skill(s) handoff-invocable"
    )
    print("restart the harness, or run just harness <name> / just smoke <name>")


def plan() -> None:
    mode = "marketplace" if marketplace_source() else "source-linked"
    roots, play_links, rote_skills = desired_profile(mode)
    state = load_state()
    managed_links = {Path(str(value)) for value in state["play_links"]} if state else set()
    conflicts = [
        link
        for link in play_links
        if (link.exists() or link.is_symlink()) and link not in managed_links
    ]
    for field, (managed_path, _content) in zip(
        ("launcher", "routing_launcher", "journey_launcher"), managed_launchers()
    ):
        recorded = Path(str(state.get(field))) if state and state.get(field) else None
        if (managed_path.exists() or managed_path.is_symlink()) and recorded != managed_path:
            conflicts.append(managed_path)
    print(
        f"Play-first {mode} plan: {len(roots)} harness root(s), "
        f"{len(rote_skills)} canonical rote skill(s), {len(conflicts)} Play conflict(s)"
    )
    if os.environ.get("PLAY_PROFILE_VERBOSE") == "1":
        for root in roots:
            print(f"  root {root}")
        for skill in sorted(rote_skills, key=lambda item: str(item)):
            print(f"  rote {skill}")
        for conflict in conflicts:
            print(f"  conflict {conflict}")
    if conflicts:
        raise ProfileError("install would replace existing Play paths")


def uninstall() -> None:
    state = load_state()
    if state is None:
        raise ProfileError("Play-first profile is not installed; no reversible state was found")
    source = Path(str(state["source"])).resolve()
    unsafe = []
    for value in state["play_links"]:
        link = Path(str(value))
        if link.is_symlink() and link.resolve() == source:
            continue
        if not link.exists() and not link.is_symlink():
            continue
        unsafe.append(str(link))
    if unsafe:
        raise ProfileError(
            "refusing to remove changed Play installs:\n  " + "\n  ".join(unsafe)
        )
    changed_activation_files = []
    for value, record in state["backups"].items():
        path = Path(value)
        expected = record.get("managed_sha256")
        if not path.is_file() or expected != digest(read_bytes(path)):
            changed_activation_files.append(str(path))
    if changed_activation_files:
        raise ProfileError(
            "refusing to overwrite activation files changed since install:\n  "
            + "\n  ".join(changed_activation_files)
        )

    for value in state["play_links"]:
        link = Path(str(value))
        if link.is_symlink():
            link.unlink()
    for value, record in state["backups"].items():
        restore(Path(value), record)
    state_path().unlink()
    parent = state_path().parent
    if parent.is_dir() and not any(parent.iterdir()):
        parent.rmdir()
    print(
        f"removed Play from {len(state['roots'])} harness root(s) and restored "
        f"{len(state['rote_skills'])} canonical rote skill(s)"
    )
    print("restart each running harness to reload the restored profile")


def report(require_active: bool) -> None:
    state = load_state()
    if state is None:
        if require_active:
            raise ProfileError("Play-first profile is not installed")
        marketplace = marketplace_source()
        roots = discover_roots(
            include_plugin_caches=marketplace,
            require_roots=not marketplace,
        )
        print(
            f"Play-first profile: inactive ({len(roots)} rote harness root(s) detected)"
        )
        if os.environ.get("PLAY_PROFILE_VERBOSE") == "1":
            for root in roots:
                print(f"  root {root}")
        return
    problems = verify_state(state)
    if problems:
        raise ProfileError(
            "Play-first profile verification failed:\n  " + "\n  ".join(problems)
        )
    print(
        f"Play-first profile: active ({state.get('mode', 'source-linked')}); "
        f"play implicit in {len(state['roots'])} root(s), "
        f"{len(state['rote_skills'])} canonical rote skill(s) handoff-invocable"
    )
    if os.environ.get("PLAY_PROFILE_VERBOSE") == "1":
        for root in state["roots"]:
            print(f"  root {root}")
        for skill in state["rote_skills"]:
            print(f"  rote {skill}")


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "command", choices=("install", "plan", "uninstall", "status", "verify")
    )
    args = parser.parse_args()
    try:
        if args.command == "install":
            install()
        elif args.command == "plan":
            plan()
        elif args.command == "uninstall":
            uninstall()
        else:
            report(require_active=args.command == "verify")
    except ProfileError as error:
        print(f"play-profile: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
