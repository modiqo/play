{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://play.modiqo.ai/schemas/journey-viewport.schema.json",
  "title": "Play Journey foreground viewport",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "generation",
    "material_generation",
    "projection_version",
    "state",
    "intent",
    "origin",
    "route",
    "benefit",
    "capabilities",
    "nodes",
    "edges",
    "current_node",
    "presentation",
    "telemetry",
    "source_cursor",
    "updated_at",
    "journey_key"
  ],
  "properties": {
    "schema": {"const": "play.journey-viewport/v1"},
    "generation": {"type": "integer", "minimum": 1},
    "material_generation": {"type": "integer", "minimum": 0},
    "projection_version": {"type": "string", "minLength": 1, "maxLength": 40},
    "state": {"type": "string", "minLength": 1, "maxLength": 32},
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "source"],
      "properties": {
        "label": {"type": "string", "minLength": 1, "maxLength": 400},
        "source": {"enum": ["play_capture", "recalled_play", "tutorial"]}
      }
    },
    "origin": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "kind": {"enum": ["recalled_play", "tutorial"]},
        "run_id": {"type": ["string", "null"]},
        "exact_reference": {"type": ["string", "null"]},
        "association_basis": {"enum": ["typed_workspace", "rote_namespace_time"]},
        "exploration_skipped": {"const": true},
        "source": {"const": "packaged_recording"},
        "recording_version": {"type": "string", "minLength": 1, "maxLength": 40}
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "exploration_skipped", "label"],
      "properties": {
        "mode": {"enum": ["known", "exploration", "tutorial"]},
        "exploration_skipped": {"type": "boolean"},
        "label": {"type": "string", "minLength": 1, "maxLength": 120}
      }
    },
    "benefit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["workflow_discovery_avoided", "capability_discovery_avoided", "typed_provider_operations"],
      "properties": {
        "workflow_discovery_avoided": {"type": "boolean"},
        "capability_discovery_avoided": {"type": "boolean"},
        "typed_provider_operations": {"type": "integer", "minimum": 0}
      }
    },
    "capabilities": {
      "type": "array",
      "maxItems": 96,
      "items": {"$ref": "#/$defs/capabilityInstance"}
    },
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 96,
      "items": {"$ref": "#/$defs/node"}
    },
    "edges": {
      "type": "array",
      "maxItems": 384,
      "items": {"$ref": "#/$defs/edge"}
    },
    "current_node": {"type": "string", "minLength": 1, "maxLength": 80},
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "has_material_change",
        "changed_node_ids",
        "complete",
        "total_nodes",
        "total_edges",
        "evidence_refs_omitted"
      ],
      "properties": {
        "has_material_change": {"type": "boolean"},
        "changed_node_ids": {
          "type": "array",
          "maxItems": 64,
          "items": {"type": "string", "minLength": 1, "maxLength": 80}
        },
        "complete": {"type": "boolean"},
        "total_nodes": {"type": "integer", "minimum": 1},
        "total_edges": {"type": "integer", "minimum": 0},
        "evidence_refs_omitted": {"type": "integer", "minimum": 0}
      }
    },
    "telemetry": {"$ref": "#/$defs/telemetry"},
    "source_cursor": {
      "type": "object",
      "additionalProperties": false,
      "required": ["play_events", "rote_command_sequence", "rote_response_id"],
      "properties": {
        "play_events": {"type": "integer", "minimum": 0},
        "rote_command_sequence": {"type": "integer", "minimum": 0},
        "rote_response_id": {"type": "integer", "minimum": 0}
      }
    },
    "updated_at": {"type": "string", "format": "date-time"},
    "journey_key": {"type": "string", "pattern": "^journey-[a-f0-9]{24}$"}
  },
  "$defs": {
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "play_events",
        "rote_commands",
        "rote_responses",
        "receipt_refs",
        "artifact_refs"
      ],
      "properties": {
        "play_events": {
          "type": "array",
          "maxItems": 128,
          "items": {"type": "string", "maxLength": 128}
        },
        "rote_commands": {
          "type": "array",
          "maxItems": 128,
          "items": {"type": "integer", "minimum": 1}
        },
        "rote_responses": {
          "type": "array",
          "maxItems": 128,
          "items": {"type": "string", "pattern": "^@[1-9][0-9]*$"}
        },
        "receipt_refs": {
          "type": "array",
          "maxItems": 128,
          "items": {"type": "string", "maxLength": 128}
        },
        "artifact_refs": {
          "type": "array",
          "maxItems": 128,
          "items": {"type": "string", "maxLength": 128}
        }
      }
    },
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["duration_ms", "payload_tokens", "tokens_saved"],
      "properties": {
        "duration_ms": {"type": "integer", "minimum": 0},
        "payload_tokens": {"type": "integer", "minimum": 0},
        "tokens_saved": {"type": "integer", "minimum": 0},
        "commands": {"type": "integer", "minimum": 0},
        "window_commands": {"type": "integer", "minimum": 0},
        "responses": {"type": "integer", "minimum": 0}
      }
    },
    "capabilityInstance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "id", "modality", "family", "interface", "subject", "label", "state", "initialization", "authorization", "operation_sequences", "evidence_sequences"],
      "properties": {
        "schema": {"const": "play.journey-capability-instance/v1"},
        "id": {"type": "string", "pattern": "^cap_[a-f0-9]{20}$"},
        "modality": {"enum": ["call", "shell", "drive"]},
        "family": {"enum": ["adapter", "proc", "browser"]},
        "interface": {"type": "string", "minLength": 1, "maxLength": 32},
        "subject": {"type": "string", "minLength": 1, "maxLength": 160},
        "label": {"type": "string", "minLength": 1, "maxLength": 160},
        "state": {"enum": ["ready", "active", "failed", "closed"]},
        "initialization": {
          "type": "object", "additionalProperties": false,
          "required": ["state", "basis", "first_sequence"],
          "properties": {
            "state": {"enum": ["initialized", "ready", "failed"]},
            "basis": {"enum": ["observed_probe", "observed_session_init", "observed_dependency_check", "observed_input_init", "observed_protocol_init", "observed_use", "legacy_projection"]},
            "first_sequence": {"type": ["integer", "null"], "minimum": 1}
          }
        },
        "authorization": {
          "type": "object", "additionalProperties": false,
          "required": ["state", "required", "basis"],
          "properties": {
            "state": {"enum": ["not_applicable", "unknown", "required", "satisfied", "failed"]},
            "required": {"type": ["boolean", "null"]},
            "basis": {"enum": ["typed_authority_operation", "no_authority_signal", "not_observed", "legacy_projection"]}
          }
        },
        "operation_sequences": {"type": "array", "maxItems": 128, "items": {"type": "integer", "minimum": 1}},
        "evidence_sequences": {"type": "array", "maxItems": 128, "items": {"type": "integer", "minimum": 1}}
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "kind",
        "label",
        "status",
        "confidence",
        "effect",
        "provider",
        "activity_count",
        "capability_refs",
        "modalities",
        "lifecycle_phases",
        "evidence",
        "telemetry",
        "first_sequence",
        "last_sequence"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 80},
        "kind": {
          "enum": [
            "intent",
            "phase",
            "capability",
            "decision",
            "authority",
            "effect",
            "evidence",
            "artifact",
            "blocker",
            "recovery",
            "milestone",
            "learning",
            "play_candidate",
            "play"
          ]
        },
        "label": {"type": "string", "minLength": 1, "maxLength": 120},
        "status": {
          "enum": [
            "planned",
            "active",
            "waiting",
            "blocked",
            "satisfied",
            "failed",
            "skipped",
            "superseded",
            "verified"
          ]
        },
        "confidence": {"enum": ["deterministic", "typed_event", "play_capture", "recalled_play"]},
        "effect": {"type": ["string", "null"], "maxLength": 40},
        "provider": {"type": ["string", "null"], "maxLength": 120},
        "activity_count": {"type": "integer", "minimum": 0},
        "capability_refs": {"type": "array", "maxItems": 32, "items": {"type": "string", "pattern": "^cap_[a-f0-9]{20}$"}},
        "modalities": {"type": "array", "maxItems": 3, "items": {"enum": ["call", "shell", "drive"]}},
        "lifecycle_phases": {"type": "array", "maxItems": 5, "items": {"enum": ["initialize", "authorize", "use", "observe", "close"]}},
        "evidence": {"$ref": "#/$defs/evidence"},
        "telemetry": {"$ref": "#/$defs/telemetry"},
        "first_sequence": {"type": ["integer", "null"], "minimum": 1},
        "last_sequence": {"type": ["integer", "null"], "minimum": 1},
        "recovered_node": {"type": "string", "minLength": 1, "maxLength": 80}
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "target", "kind"],
      "properties": {
        "source": {"type": "string", "minLength": 1, "maxLength": 80},
        "target": {"type": "string", "minLength": 1, "maxLength": 80},
        "kind": {
          "enum": [
            "decomposes_into",
            "requires",
            "selects",
            "authorizes",
            "executes",
            "produces",
            "verifies",
            "blocked_by",
            "recovers",
            "derived_from",
            "refines",
            "crystallizes_into"
          ]
        }
      }
    }
  }
}
