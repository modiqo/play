#!/usr/bin/env python3
"""Thin entrypoint for the structural sidekick interceptor."""

from __future__ import annotations

import sys
from pathlib import Path


ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "scripts" / "lib"))

from play.python_environment import ensure_runtime

ensure_runtime("play-intercept", ROOT, Path(__file__).resolve(), sys.argv[1:])

from play.intercept import main


if __name__ == "__main__":
    raise SystemExit(main())
