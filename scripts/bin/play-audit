#!/usr/bin/env python3
"""Thin entrypoint for the advisory Play audit.

The audit's body rules need the pinned ``ast-grep-py`` wheel. When the
interpreter running this script lacks it, re-exec under ``uv run`` against the
Play project so the locked environment is used, the way play-journey does.
Without uv the audit still runs; body rules are reported as skipped.
"""

from __future__ import annotations

import os
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parents[2]
sys.path.insert(0, str(ROOT / "scripts" / "lib"))

from play.python_environment import ensure_runtime

ensure_runtime(
    "play-audit",
    ROOT,
    Path(__file__).resolve(),
    sys.argv[1:],
    advisory=True,
    extra_environment={"PLAY_AUDIT_HOST_PATH": os.environ.get("PATH", "")},
)


def _main() -> int:
    try:
        from play.audit.cli import main
    except ImportError as error:
        # Advisory by contract: never a traceback, never a non-zero exit.
        print(
            f"audit unavailable: {error}. Install uv, or the pinned Play Python "
            f"dependencies for {sys.executable}, to enable the audit.",
            file=sys.stderr,
        )
        return 0
    return main()


if __name__ == "__main__":
    raise SystemExit(_main())
