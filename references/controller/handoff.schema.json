{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://play.modiqo.ai/schemas/play.handoff.v1.json",
  "title": "Play specialist handoff packet or receipt",
  "oneOf": [
    {"$ref": "#/$defs/packet"},
    {"$ref": "#/$defs/receipt"},
    {"$ref": "#/$defs/authenticationPacket"},
    {"$ref": "#/$defs/authenticationReceipt"}
  ],
  "$defs": {
    "specialistOwner": {
      "enum": ["rote-using-adapters", "rote-shell", "rote-browse", "rote-workspace"]
    },
    "stringArray": {
      "type": "array",
      "items": {"type": "string"}
    },
    "packet": {
      "type": "object",
      "required": ["schema", "run_id", "state", "action", "owner", "requested_outcome", "modalities", "constraints", "inputs", "capability_policy", "adapter_discovery", "expected_events", "effect_policy", "evidence_contract", "idempotency_key"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "play.handoff/v1"},
        "run_id": {"type": "string", "minLength": 1},
        "state": {"const": "explore_execute"},
        "action": {"const": "execute_route"},
        "owner": {"$ref": "#/$defs/specialistOwner"},
        "requested_outcome": {"type": "string", "minLength": 1},
        "modalities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["call", "shell", "drive"]}},
        "constraints": {"type": "object"},
        "inputs": {"type": "object"},
        "capability_policy": {
          "oneOf": [
            {
              "type": "object",
              "required": ["kind", "require_rote_adapter", "discovery_order", "type_selection", "substrate_detection", "create_owner", "configure_owner", "orchestration_owner", "adapter_execute_owner", "auth_cycle", "direct_tool_policy"],
              "additionalProperties": false,
              "properties": {
                "kind": {"const": "rote_adapter"},
                "require_rote_adapter": {"const": true},
                "discovery_order": {"const": ["installed", "catalog", "provided_spec", "provider_docs"]},
                "type_selection": {"const": "auto"},
                "substrate_detection": {"const": ["openapi", "graphql", "mcp"]},
                "create_owner": {"const": "rote-adapter-create"},
                "configure_owner": {"const": "rote-adapter-config"},
                "orchestration_owner": {"$ref": "#/$defs/specialistOwner"},
                "adapter_execute_owner": {"const": "rote-using-adapters"},
                "auth_cycle": {
                  "type": "object",
                  "required": ["required", "human_gate", "secret_entry", "completion"],
                  "additionalProperties": false,
                  "properties": {
                    "required": {"const": true},
                    "human_gate": {"const": true},
                    "secret_entry": {"const": "masked"},
                    "completion": {"const": ["verified", "completed"]}
                  }
                },
                "direct_tool_policy": {"const": "metadata_discovery_only_never_execute"}
              }
            },
            {
              "type": "object",
              "required": ["kind", "orchestration_owner", "direct_tool_policy"],
              "additionalProperties": false,
              "properties": {
                "kind": {"const": "rote_native"},
                "orchestration_owner": {"$ref": "#/$defs/specialistOwner"},
                "direct_tool_policy": {"const": "never_execute"}
              }
            }
          ]
        },
        "adapter_discovery": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/adapterDiscovery"}
          ]
        },
        "expected_events": {
          "type": "object",
          "required": ["outcome_ready", "route_exhausted", "confirmation_required", "authentication_required"],
          "additionalProperties": false,
          "properties": {
            "outcome_ready": {"const": ["result_ref", "response_refs", "artifact_refs", "modalities_used", "effects", "route_provenance"]},
            "route_exhausted": {"const": ["reason", "evidence_refs"]},
            "confirmation_required": {"const": ["effect_confirmation"]},
            "authentication_required": {"const": ["authentication"]}
          }
        },
        "effect_policy": {"type": "object"},
        "evidence_contract": {"$ref": "#/$defs/stringArray"},
        "idempotency_key": {"type": "string", "minLength": 1},
        "resume": {"$ref": "#/$defs/authenticationResume"}
      }
    },
    "adapterDiscovery": {
      "type": "object",
      "required": ["status", "query", "searched_sources", "choices", "selected_id", "evidence_refs"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["installed_ready", "catalog_empty", "selected", "catalog_rejected"]},
        "query": {"type": "string", "minLength": 1},
        "searched_sources": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["installed", "catalog"]}},
        "choices": {"type": "array", "items": {"$ref": "#/$defs/adapterChoice"}},
        "selected_id": {"type": ["string", "null"]},
        "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "adapterChoice": {
      "type": "object",
      "required": ["id", "label", "description", "source", "provider", "category", "substrate", "auth_shape", "health", "install_impact", "next_command"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "source": {"enum": ["installed", "catalog"]},
        "provider": {"type": ["string", "null"]},
        "category": {"type": ["string", "null"]},
        "substrate": {"enum": ["openapi", "graphql", "mcp", "google_discovery", "unknown"]},
        "auth_shape": {"enum": ["none", "static_token", "api_key", "basic", "oauth2", "mcp_oauth_dcr", "ambiguous", "unknown"]},
        "health": {"enum": ["ready", "degraded", "auth_required", "unknown"]},
        "install_impact": {"enum": ["none", "local-write", "human-gate", "unknown"]},
        "next_command": {"type": ["string", "null"]}
      }
    },
    "receipt": {
      "type": "object",
      "required": ["schema", "packet_sha256", "run_id", "state", "action", "owner", "executor", "event", "payload", "evidence_refs"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "play.handoff-receipt/v1"},
        "packet_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "run_id": {"type": "string", "minLength": 1},
        "state": {"const": "explore_execute"},
        "action": {"const": "execute_route"},
        "owner": {"$ref": "#/$defs/specialistOwner"},
        "executor": {
          "type": "object",
          "required": ["kind", "name"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "skill"},
            "name": {"$ref": "#/$defs/specialistOwner"}
          }
        },
        "event": {"enum": ["outcome_ready", "route_exhausted", "confirmation_required", "authentication_required"]},
        "payload": {
          "type": "object",
          "properties": {
            "route_provenance": {"$ref": "#/$defs/routeProvenance"},
            "effect_confirmation": {"$ref": "#/$defs/effectConfirmationRequired"},
            "authentication": {"$ref": "#/$defs/authenticationRequired"}
          }
        },
        "evidence_refs": {"$ref": "#/$defs/stringArray"}
      }
    },
    "effectConfirmationRequired": {
      "type": "object",
      "required": ["source", "status", "tool", "impact", "confirm_token", "workspace", "evidence_refs"],
      "additionalProperties": false,
      "properties": {
        "source": {"const": "rote_confirmation_required"},
        "status": {"const": "required"},
        "tool": {"type": "string", "minLength": 1},
        "impact": {"type": "string", "minLength": 1},
        "confirm_token": {"type": "string", "minLength": 1},
        "workspace": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "authenticationRequired": {
      "type": "object",
      "required": ["source", "status", "recoverable", "adapter_id", "env_var", "classified_rung", "distinguishing_error", "evidence_refs"],
      "additionalProperties": false,
      "properties": {
        "source": {"const": "rote_authentication_required"},
        "status": {"const": "required"},
        "recoverable": {"const": true},
        "adapter_id": {"type": "string", "minLength": 1},
        "env_var": {"type": "string", "minLength": 1},
        "classified_rung": {"type": "string", "minLength": 1},
        "distinguishing_error": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "authenticationResult": {
      "type": "object",
      "required": ["source", "status", "adapter_id", "env_var", "classified_rung", "authentication_action", "evidence_refs"],
      "additionalProperties": false,
      "properties": {
        "source": {"const": "rote_authentication_result"},
        "status": {"const": "authenticated"},
        "adapter_id": {"type": "string", "minLength": 1},
        "env_var": {"type": "string", "minLength": 1},
        "classified_rung": {"type": "string", "minLength": 1},
        "authentication_action": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "authenticationResume": {
      "type": "object",
      "required": ["kind", "original_packet_sha256", "authentication_receipt_ref", "adapter_id", "classified_rung"],
      "additionalProperties": false,
      "properties": {
        "kind": {"const": "authentication"},
        "original_packet_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "authentication_receipt_ref": {"type": "string", "minLength": 1},
        "adapter_id": {"type": "string", "minLength": 1},
        "classified_rung": {"type": "string", "minLength": 1}
      }
    },
    "authenticationPacket": {
      "type": "object",
      "required": ["schema", "run_id", "state", "action", "owner", "requested_outcome", "authentication", "original_packet", "original_packet_sha256", "expected_events", "evidence_contract", "idempotency_key"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "play.authentication-handoff/v1"},
        "run_id": {"type": "string", "minLength": 1},
        "state": {"const": "authentication_execute"},
        "action": {"const": "execute_authentication"},
        "owner": {"const": "rote-adapter-config"},
        "requested_outcome": {"type": "string", "minLength": 1},
        "authentication": {"$ref": "#/$defs/authenticationRequired"},
        "original_packet": {"$ref": "#/$defs/packet"},
        "original_packet_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "expected_events": {
          "type": "object",
          "required": ["authentication_ready", "authentication_failed"],
          "additionalProperties": false,
          "properties": {
            "authentication_ready": {"const": ["authentication"]},
            "authentication_failed": {"const": ["reason", "evidence_refs"]}
          }
        },
        "evidence_contract": {"$ref": "#/$defs/stringArray"},
        "idempotency_key": {"type": "string", "minLength": 1}
      }
    },
    "authenticationReceipt": {
      "type": "object",
      "required": ["schema", "packet_sha256", "run_id", "state", "action", "owner", "executor", "event", "payload", "evidence_refs"],
      "additionalProperties": false,
      "properties": {
        "schema": {"const": "play.authentication-receipt/v1"},
        "packet_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "run_id": {"type": "string", "minLength": 1},
        "state": {"const": "authentication_execute"},
        "action": {"const": "execute_authentication"},
        "owner": {"const": "rote-adapter-config"},
        "executor": {
          "type": "object",
          "required": ["kind", "name"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "skill"},
            "name": {"const": "rote-adapter-config"}
          }
        },
        "event": {"enum": ["authentication_ready", "authentication_failed"]},
        "payload": {
          "type": "object",
          "properties": {
            "authentication": {"$ref": "#/$defs/authenticationResult"},
            "reason": {"type": "string", "minLength": 1},
            "evidence_refs": {"$ref": "#/$defs/stringArray"}
          }
        },
        "evidence_refs": {"$ref": "#/$defs/stringArray"}
      }
    },
    "routeProvenance": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "adapter_id", "substrate", "type_evidence_ref", "adapter_status", "creation_owner", "auth_status", "auth_owner", "orchestration_owner", "adapter_execute_owner", "direct_tool_execution", "evidence_refs"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "rote_adapter"},
            "adapter_id": {"type": "string", "minLength": 1},
            "substrate": {"enum": ["openapi", "graphql", "mcp"]},
            "type_evidence_ref": {"type": "string", "minLength": 1},
            "adapter_status": {"enum": ["reused", "created"]},
            "creation_owner": {"type": ["string", "null"], "enum": ["rote-adapter-create", null]},
            "auth_status": {"enum": ["verified", "completed"]},
            "auth_owner": {"enum": ["rote-using-adapters", "rote-adapter-create", "rote-adapter-config"]},
            "orchestration_owner": {"$ref": "#/$defs/specialistOwner"},
            "adapter_execute_owner": {"const": "rote-using-adapters"},
            "direct_tool_execution": {"const": false},
            "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        },
        {
          "type": "object",
          "required": ["kind", "orchestration_owner", "direct_tool_execution", "evidence_refs"],
          "additionalProperties": false,
          "properties": {
            "kind": {"const": "rote_native"},
            "orchestration_owner": {"$ref": "#/$defs/specialistOwner"},
            "direct_tool_execution": {"const": false},
            "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
          }
        }
      ]
    }
  }
}
