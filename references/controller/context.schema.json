{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://play.modiqo.ai/schemas/play.context.v1.json",
  "title": "Play logical controller context",
  "$comment": "This schema defines logical controller state only. It does not define or authorize filesystem persistence. Implementations must keep context in harness-owned state unless an explicit Play storage backend and ownership policy are provided.",
  "type": "object",
  "required": [
    "schema",
    "machine_version",
    "run_id",
    "task_key",
    "state",
    "transition_seq",
    "mode",
    "request",
    "search",
    "match",
    "inspection",
    "resolution",
    "play",
    "readiness",
    "route",
    "adapter_discovery",
    "consent",
    "modality_policy",
    "judge_policy",
    "effect_policy",
    "output_policy",
    "output",
    "execution",
    "handoff",
    "auth_repair",
    "evidence",
    "candidate",
    "birth",
    "awareness",
    "creator",
    "management",
    "publication",
    "publication_validation",
    "receipt_ref",
    "last_event"
  ],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "play.context/v1"},
    "machine_version": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "task_key": {"type": "string", "minLength": 1},
    "state": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "transition_seq": {"type": "integer", "minimum": 0},
    "mode": {"type": ["string", "null"], "enum": ["awareness", "use", "explore", "create", "manage", "exited", null]},
    "request": {"$ref": "#/$defs/request"},
    "search": {"$ref": "#/$defs/search"},
    "match": {"$ref": "#/$defs/match"},
    "inspection": {"$ref": "#/$defs/inspection"},
    "resolution": {"$ref": "#/$defs/resolution"},
    "play": {"$ref": "#/$defs/play"},
    "readiness": {"$ref": "#/$defs/readiness"},
    "route": {"$ref": "#/$defs/route"},
    "adapter_discovery": {"$ref": "#/$defs/adapterDiscovery"},
    "consent": {"$ref": "#/$defs/consent"},
    "modality_policy": {"$ref": "#/$defs/modalityPolicy"},
    "judge_policy": {"$ref": "#/$defs/judgePolicy"},
    "effect_policy": {"$ref": "#/$defs/effectPolicy"},
    "output_policy": {
      "$ref": "#/$defs/outputPolicy",
      "default": {"mode": "detailed", "preferred_presentation": "human", "max_inline_bytes": 200000, "overflow": "artifact"}
    },
    "output": {"$ref": "#/$defs/runOutput"},
    "execution": {"$ref": "#/$defs/execution"},
    "handoff": {"$ref": "#/$defs/handoff"},
    "auth_repair": {"$ref": "#/$defs/authRepair"},
    "evidence": {"$ref": "#/$defs/evidence"},
    "candidate": {"$ref": "#/$defs/candidate"},
    "birth": {"$ref": "#/$defs/birth"},
    "awareness": {"$ref": "#/$defs/awareness"},
    "creator": {"$ref": "#/$defs/creator"},
    "management": {"$ref": "#/$defs/management"},
    "publication": {"$ref": "#/$defs/publication"},
    "publication_validation": {"$ref": "#/$defs/publicationValidation"},
    "receipt_ref": {"$ref": "#/$defs/nullableString"},
    "last_event": {"$ref": "#/$defs/lastEvent"}
  },
  "$defs": {
    "nullableString": {"type": ["string", "null"]},
    "stringArray": {"type": "array", "items": {"type": "string"}},
    "request": {
      "type": "object",
      "required": ["original", "intent", "requested_outcome", "parameters", "excluded"],
      "additionalProperties": false,
      "properties": {
        "original": {"type": "string"},
        "intent": {"$ref": "#/$defs/nullableString"},
        "requested_outcome": {"$ref": "#/$defs/nullableString"},
        "parameters": {"type": "object"},
        "excluded": {"type": "boolean"}
      }
    },
    "search": {
      "type": "object",
      "required": ["complete", "query", "sources", "result_refs", "results", "play_choices"],
      "additionalProperties": false,
      "properties": {
        "complete": {"type": "boolean"},
        "query": {"$ref": "#/$defs/nullableString"},
        "sources": {"$ref": "#/$defs/stringArray"},
        "result_refs": {"$ref": "#/$defs/stringArray"},
        "results": {"type": "array", "items": {"$ref": "#/$defs/searchResult"}},
        "play_choices": {"type": "array", "items": {"$ref": "#/$defs/searchChoice"}}
      }
    },
    "searchResult": {
      "type": "object",
      "required": ["name", "description", "reference", "exact_reference", "version", "status", "sources", "score", "uri", "run_command", "inspect_command", "hint_kind", "local_availability", "execution_resolution", "selection_description"],
      "additionalProperties": false,
      "properties": {
        "name": {"type": "string"},
        "description": {"type": "string"},
        "reference": {"$ref": "#/$defs/nullableString"},
        "exact_reference": {"$ref": "#/$defs/nullableString"},
        "version": {"$ref": "#/$defs/nullableString"},
        "status": {"$ref": "#/$defs/nullableString"},
        "sources": {
          "type": "array",
          "uniqueItems": true,
          "items": {"enum": ["local", "registry"]}
        },
        "score": {"type": "number", "minimum": 0},
        "uri": {"type": "string", "minLength": 1},
        "run_command": {"type": "string", "minLength": 1},
        "inspect_command": {"type": "string"},
        "hint_kind": {"enum": ["play", "local-flow-gap"]},
        "local_availability": {"enum": ["found", "not_found", "local_only"]},
        "execution_resolution": {"enum": ["inspect_required", "pull_expected", "publish_required"]},
        "selection_description": {"type": "string", "minLength": 1}
      }
    },
    "searchChoice": {
      "type": "object",
      "required": ["reference", "label", "description", "parameters"],
      "additionalProperties": false,
      "properties": {
        "reference": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "parameters": {"type": "object"}
      }
    },
    "match": {
      "type": "object",
      "required": ["classification", "reference", "covered", "uncovered"],
      "additionalProperties": false,
      "properties": {
        "classification": {"type": ["string", "null"], "enum": ["full", "partial", "uncertain", "none", null]},
        "reference": {"$ref": "#/$defs/nullableString"},
        "covered": {"$ref": "#/$defs/stringArray"},
        "uncovered": {"$ref": "#/$defs/stringArray"}
      }
    },
    "inspection": {
      "type": "object",
      "required": ["complete", "exact_reference", "description", "local_change", "dependencies", "operations", "effects", "blockers", "disclosure_sha256"],
      "additionalProperties": false,
      "properties": {
        "complete": {"type": "boolean"},
        "exact_reference": {"$ref": "#/$defs/nullableString"},
        "description": {"type": "string"},
        "local_change": {"type": ["string", "null"], "enum": ["none", "install", "replace_or_repair", "unknown", null]},
        "dependencies": {"type": "object"},
        "operations": {"type": "array", "items": {"type": "object"}},
        "effects": {"type": "object"},
        "blockers": {"$ref": "#/$defs/stringArray"},
        "disclosure_sha256": {"$ref": "#/$defs/nullableString"}
      }
    },
    "resolution": {
      "type": "object",
      "required": ["local_state", "source", "pull_performed"],
      "additionalProperties": false,
      "properties": {
        "local_state": {"enum": ["exact_ready", "missing", "stale", "corrupt", "unknown"]},
        "source": {"$ref": "#/$defs/nullableString"},
        "pull_performed": {"type": "boolean"}
      }
    },
    "play": {
      "type": "object",
      "required": ["version", "owner", "modalities", "effects"],
      "additionalProperties": false,
      "properties": {
        "version": {"$ref": "#/$defs/nullableString"},
        "owner": {"$ref": "#/$defs/nullableString"},
        "modalities": {"$ref": "#/$defs/stringArray"},
        "effects": {"$ref": "#/$defs/stringArray"}
      }
    },
    "outputPolicy": {
      "type": "object",
      "required": ["mode", "preferred_presentation", "max_inline_bytes", "overflow"],
      "additionalProperties": false,
      "properties": {
        "mode": {"const": "detailed"},
        "preferred_presentation": {"enum": ["human", "json"]},
        "max_inline_bytes": {"type": "integer", "minimum": 1},
        "overflow": {"const": "artifact"}
      }
    },
    "runOutput": {
      "type": "object",
      "required": ["mode", "detail", "source", "format", "primary", "manifest", "truncated", "full_output_ref", "presentation_markdown", "presentation_sha256", "inline_bytes", "primary_bytes", "format_ns"],
      "additionalProperties": false,
      "properties": {
        "mode": {"type": ["string", "null"], "enum": ["detailed", null]},
        "detail": {"type": ["string", "null"], "enum": ["full", "summary", null]},
        "source": {"type": ["string", "null"], "enum": ["rote_human_presentation", "rote_json_presentation", "structured_responses", "rote_compact_summary", null]},
        "format": {"type": ["string", "null"], "enum": ["markdown", "json", "text", null]},
        "primary": {},
        "manifest": {"$ref": "#/$defs/outputManifest"},
        "truncated": {"type": "boolean"},
        "full_output_ref": {"$ref": "#/$defs/nullableString"},
        "presentation_markdown": {"$ref": "#/$defs/nullableString"},
        "presentation_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "inline_bytes": {"type": ["integer", "null"], "minimum": 0},
        "primary_bytes": {"type": ["integer", "null"], "minimum": 0},
        "format_ns": {"type": ["integer", "null"], "minimum": 0}
      }
    },
    "outputManifest": {
      "type": "object",
      "required": ["response_refs", "artifact_refs", "effects"],
      "additionalProperties": false,
      "properties": {
        "response_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "artifact_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "effects": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "handoff": {
      "type": "object",
      "required": ["owner", "available", "packet", "packet_sha256", "expected_events", "receipt", "receipt_ref", "receipt_valid", "blocked_reason"],
      "additionalProperties": false,
      "properties": {
        "owner": {"type": ["string", "null"], "enum": ["rote-using-adapters", "rote-shell", "rote-browse", "rote-workspace", null]},
        "available": {"type": "boolean"},
        "packet": {"type": ["object", "null"]},
        "packet_sha256": {"$ref": "#/$defs/nullableString"},
        "expected_events": {"$ref": "#/$defs/stringArray"},
        "receipt": {"type": ["object", "null"]},
        "receipt_ref": {"$ref": "#/$defs/nullableString"},
        "receipt_valid": {"type": "boolean"},
        "blocked_reason": {"$ref": "#/$defs/nullableString"}
      }
    },
    "readiness": {
      "type": "object",
      "required": ["status", "exact_version"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["unknown", "ready", "resolution_required", "drifted"]},
        "exact_version": {"$ref": "#/$defs/nullableString"}
      }
    },
    "route": {
      "type": "object",
      "required": ["modalities", "justification"],
      "additionalProperties": false,
      "properties": {
        "modalities": {"type": "array", "uniqueItems": true, "items": {"enum": ["call", "shell", "drive"]}},
        "justification": {"$ref": "#/$defs/nullableString"}
      }
    },
    "adapterDiscovery": {
      "type": "object",
      "required": ["status", "query", "searched_sources", "choices", "selected_id", "evidence_refs"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["unknown", "installed_ready", "installed_choices", "catalog_choices", "catalog_empty", "selected", "catalog_rejected"]},
        "query": {"$ref": "#/$defs/nullableString"},
        "searched_sources": {"type": "array", "uniqueItems": true, "items": {"enum": ["installed", "catalog"]}},
        "choices": {"type": "array", "items": {"$ref": "#/$defs/adapterChoice"}},
        "selected_id": {"$ref": "#/$defs/nullableString"},
        "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "adapterChoice": {
      "type": "object",
      "required": ["id", "label", "description", "source", "provider", "category", "substrate", "auth_shape", "health", "install_impact", "next_command"],
      "additionalProperties": false,
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "source": {"enum": ["installed", "catalog"]},
        "provider": {"$ref": "#/$defs/nullableString"},
        "category": {"$ref": "#/$defs/nullableString"},
        "substrate": {"enum": ["openapi", "graphql", "mcp", "google_discovery", "unknown"]},
        "auth_shape": {"enum": ["none", "static_token", "api_key", "basic", "oauth2", "mcp_oauth_dcr", "ambiguous", "unknown"]},
        "health": {"enum": ["ready", "degraded", "auth_required", "unknown"]},
        "install_impact": {"enum": ["none", "local-write", "human-gate", "unknown"]},
        "next_command": {"$ref": "#/$defs/nullableString"}
      }
    },
    "consent": {
      "type": "object",
      "required": ["explore", "save"],
      "additionalProperties": false,
      "properties": {
        "explore": {"enum": ["approved", "declined", "not_asked"]},
        "save": {"enum": ["private", "public", "skip", "not_asked"]}
      }
    },
    "modalityPolicy": {
      "type": "object",
      "required": ["mode", "allowed", "forbidden", "widening_requires_approval"],
      "additionalProperties": false,
      "properties": {
        "mode": {"enum": ["auto", "manual"]},
        "allowed": {"type": "array", "uniqueItems": true, "items": {"enum": ["call", "shell", "drive"]}},
        "forbidden": {"type": "array", "uniqueItems": true, "items": {"enum": ["call", "shell", "drive"]}},
        "widening_requires_approval": {"const": true}
      }
    },
    "judgePolicy": {
      "type": "object",
      "required": ["allowed", "harness"],
      "additionalProperties": false,
      "properties": {
        "allowed": {"type": "boolean"},
        "harness": {"$ref": "#/$defs/nullableString"}
      }
    },
    "effectPolicy": {
      "type": "object",
      "required": ["read_only", "approval_gates", "rote_confirmation"],
      "additionalProperties": false,
      "properties": {
        "read_only": {"type": "boolean"},
        "approval_gates": {"$ref": "#/$defs/stringArray"},
        "rote_confirmation": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/effectConfirmation"}
          ]
        }
      }
    },
    "effectConfirmation": {
      "type": "object",
      "required": ["source", "status", "tool", "impact", "confirm_token", "workspace", "evidence_refs"],
      "additionalProperties": false,
      "properties": {
        "source": {"const": "rote_confirmation_required"},
        "status": {"enum": ["required", "approved", "declined"]},
        "tool": {"type": "string", "minLength": 1},
        "impact": {"type": "string", "minLength": 1},
        "confirm_token": {"type": "string", "minLength": 1},
        "workspace": {"type": "string", "minLength": 1},
        "evidence_refs": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }
    },
    "authRepair": {
      "type": "object",
      "required": ["status", "owner", "recoverable", "adapter_id", "env_var", "classified_rung", "distinguishing_error", "repair_action", "original_packet", "original_packet_sha256", "packet", "packet_sha256", "receipt", "receipt_ref", "receipt_valid", "blocked_reason", "evidence_refs"],
      "additionalProperties": false,
      "properties": {
        "status": {"enum": ["none", "required", "approved", "repairing", "repaired", "declined", "failed"]},
        "owner": {"type": ["string", "null"], "enum": ["rote-adapter-config", null]},
        "recoverable": {"type": ["boolean", "null"]},
        "adapter_id": {"$ref": "#/$defs/nullableString"},
        "env_var": {"$ref": "#/$defs/nullableString"},
        "classified_rung": {"$ref": "#/$defs/nullableString"},
        "distinguishing_error": {"$ref": "#/$defs/nullableString"},
        "repair_action": {"$ref": "#/$defs/nullableString"},
        "original_packet": {"type": ["object", "null"]},
        "original_packet_sha256": {"$ref": "#/$defs/nullableString"},
        "packet": {"type": ["object", "null"]},
        "packet_sha256": {"$ref": "#/$defs/nullableString"},
        "receipt": {"type": ["object", "null"]},
        "receipt_ref": {"$ref": "#/$defs/nullableString"},
        "receipt_valid": {"type": "boolean"},
        "blocked_reason": {"$ref": "#/$defs/nullableString"},
        "evidence_refs": {"$ref": "#/$defs/stringArray"}
      }
    },
    "execution": {
      "type": "object",
      "required": ["owner", "workspace", "attempts", "budget", "pending_action", "idempotency_key"],
      "additionalProperties": false,
      "properties": {
        "owner": {"type": ["string", "null"], "enum": ["rote-using-adapters", "rote-shell", "rote-browse", "rote-workspace", null]},
        "workspace": {"$ref": "#/$defs/nullableString"},
        "attempts": {"type": "integer", "minimum": 0},
        "budget": {"type": "integer", "minimum": 0},
        "pending_action": {"$ref": "#/$defs/nullableString"},
        "idempotency_key": {"$ref": "#/$defs/nullableString"}
      }
    },
    "evidence": {
      "type": "object",
      "required": ["baseline", "responses", "artifacts", "verification", "failed_receipt"],
      "additionalProperties": false,
      "properties": {
        "baseline": {"$ref": "#/$defs/nullableString"},
        "responses": {"$ref": "#/$defs/stringArray"},
        "artifacts": {"$ref": "#/$defs/stringArray"},
        "verification": {"$ref": "#/$defs/nullableString"},
        "failed_receipt": {"$ref": "#/$defs/nullableString"}
      }
    },
    "candidate": {
      "type": "object",
      "required": ["reference", "reusable", "contract", "released_flow"],
      "additionalProperties": false,
      "properties": {
        "reference": {"$ref": "#/$defs/nullableString"},
        "reusable": {"type": ["boolean", "null"]},
        "contract": {"$ref": "#/$defs/nullableString"},
        "released_flow": {"$ref": "#/$defs/nullableString"}
      }
    },
    "birth": {
      "type": "object",
      "required": ["selector", "sha256", "flow_fingerprint", "object_ref", "capture_ref", "exact_reference", "registry_content_hash", "binding_ref"],
      "additionalProperties": false,
      "properties": {
        "selector": {"$ref": "#/$defs/nullableString"},
        "sha256": {"$ref": "#/$defs/nullableString"},
        "flow_fingerprint": {"$ref": "#/$defs/nullableString"},
        "object_ref": {"$ref": "#/$defs/nullableString"},
        "capture_ref": {"$ref": "#/$defs/nullableString"},
        "exact_reference": {"$ref": "#/$defs/nullableString"},
        "registry_content_hash": {"$ref": "#/$defs/nullableString"},
        "binding_ref": {"$ref": "#/$defs/nullableString"}
      }
    },
    "awareness": {
      "type": "object",
      "required": ["window_days", "complete", "digest_ref", "play_choices"],
      "additionalProperties": false,
      "properties": {
        "window_days": {"type": "integer", "minimum": 1, "maximum": 90},
        "complete": {"type": "boolean"},
        "digest_ref": {"$ref": "#/$defs/nullableString"},
        "play_choices": {"type": "array", "items": {"$ref": "#/$defs/awarenessChoice"}}
      }
    },
    "awarenessChoice": {
      "type": "object",
      "required": ["reference", "label", "description", "parameters"],
      "additionalProperties": false,
      "properties": {
        "reference": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1},
        "parameters": {"type": "object"}
      }
    },
    "creator": {
      "type": "object",
      "required": ["intent", "seed_reference"],
      "additionalProperties": false,
      "properties": {
        "intent": {"type": ["string", "null"], "enum": ["self", "private-share", "public-share", "unspecified", null]},
        "seed_reference": {"$ref": "#/$defs/nullableString"}
      }
    },
    "management": {
      "type": "object",
      "required": ["views", "org_summary_ref", "plays_by_org_ref"],
      "additionalProperties": false,
      "properties": {
        "views": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["org_summary", "plays_by_org"]}
        },
        "org_summary_ref": {"$ref": "#/$defs/nullableString"},
        "plays_by_org_ref": {"$ref": "#/$defs/nullableString"}
      }
    },
    "adapterCredentialContract": {
      "type": "object",
      "required": ["adapter_id", "selected_source", "selected_version", "fingerprint", "auth_family", "credential_names", "credential_status", "provenance"],
      "additionalProperties": false,
      "properties": {
        "adapter_id": {"type": "string", "minLength": 1},
        "selected_source": {"type": "string", "minLength": 1},
        "selected_version": {"type": "string", "minLength": 1},
        "fingerprint": {"type": "string", "minLength": 1},
        "auth_family": {"enum": ["none", "static", "oauth"]},
        "credential_names": {"$ref": "#/$defs/stringArray"},
        "credential_status": {"type": "string", "minLength": 1},
        "provenance": {"const": "receipt_verified"}
      }
    },
    "publicationValidation": {
      "type": "object",
      "required": ["credential_status", "adapter_contracts", "credential_contract_sha256", "credential_check_ns", "smoke_status", "smoke_exact_reference", "smoke_run_ref", "smoke_output_sha256", "smoke_output_bytes", "smoke_ns", "isolated_workdir", "failure_reason", "evidence_refs"],
      "additionalProperties": false,
      "properties": {
        "credential_status": {"enum": ["not_required", "pending", "verified", "failed"]},
        "adapter_contracts": {
          "type": "array",
          "items": {"$ref": "#/$defs/adapterCredentialContract"}
        },
        "credential_contract_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "credential_check_ns": {"type": ["integer", "null"], "minimum": 0},
        "smoke_status": {"enum": ["not_required", "pending", "verified", "failed"]},
        "smoke_exact_reference": {"$ref": "#/$defs/nullableString"},
        "smoke_run_ref": {"$ref": "#/$defs/nullableString"},
        "smoke_output_sha256": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
        "smoke_output_bytes": {"type": ["integer", "null"], "minimum": 0},
        "smoke_ns": {"type": ["integer", "null"], "minimum": 0},
        "isolated_workdir": {"type": "boolean"},
        "failure_reason": {"$ref": "#/$defs/nullableString"},
        "evidence_refs": {"$ref": "#/$defs/stringArray"}
      }
    },
    "publication": {
      "type": "object",
      "required": ["owner", "private_org", "canonical_reference", "title", "description", "uri", "install_uri", "content_hash", "visibility", "indexed", "index_ref", "inspect_ref", "share_copy", "presentation_ref", "presented"],
      "additionalProperties": false,
      "properties": {
        "owner": {"$ref": "#/$defs/nullableString"},
        "private_org": {"$ref": "#/$defs/nullableString"},
        "canonical_reference": {"$ref": "#/$defs/nullableString"},
        "title": {"$ref": "#/$defs/nullableString"},
        "description": {"$ref": "#/$defs/nullableString"},
        "uri": {"$ref": "#/$defs/nullableString"},
        "install_uri": {"$ref": "#/$defs/nullableString"},
        "content_hash": {"$ref": "#/$defs/nullableString"},
        "visibility": {"type": ["string", "null"], "enum": ["private", "public", null]},
        "indexed": {"type": "boolean"},
