{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://play.modiqo.ai/schemas/play.machine.v1.json",
  "title": "Play declarative machine",
  "type": "object",
  "required": ["schema", "machine", "initial", "terminal", "states"],
  "additionalProperties": false,
  "properties": {
    "schema": {"const": "play.machine/v1"},
    "machine": {"const": "play"},
    "initial": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "terminal": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
    },
    "states": {
      "type": "object",
      "minProperties": 1,
      "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
      "additionalProperties": {"$ref": "#/$defs/state"}
    }
  },
  "$defs": {
    "state": {
      "type": "object",
      "required": ["owner"],
      "additionalProperties": false,
      "properties": {
        "owner": {"enum": ["play", "rote-specialist", "flow-runtime"]},
        "checkpoint": {"enum": ["none", "before", "after", "both"]},
        "requires": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[a-z][a-z0-9_.]*$"}
        },
        "entry": {
          "type": "object",
          "required": ["action"],
          "additionalProperties": false,
          "properties": {
            "action": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
          }
        },
        "prompt": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "on": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": {"pattern": "^[a-z][a-z0-9_]*$"},
          "additionalProperties": {
            "type": "array",
            "minItems": 1,
            "items": {"$ref": "#/$defs/transition"}
          }
        }
      }
    },
    "transition": {
      "type": "object",
      "required": ["target", "mutate"],
      "additionalProperties": false,
      "properties": {
        "guard": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "target": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
        "mutate": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"}
      }
    }
  }
}
