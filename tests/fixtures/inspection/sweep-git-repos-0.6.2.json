  "parameters": [
    {
      "name": "base_dir",
      "type": "string",
      "required": false,
      "default": "~/Documents",
      "description": "Folder to sweep. A tilde path like ~/code is expanded to your home folder. Give an absolute path otherwise. A relative one resolves against the run workspace rather than your shell, so it will usually not be found.",
      "example": "~/Documents",
      "input": {
        "label": "Base dir",
        "allow_custom": true
      }
    },
    {
      "name": "max_depth",
      "type": "string",
      "required": false,
      "default": "3",
      "description": "How many folder levels below base_dir to search. Must be a whole number; clamped to 1..6. Anything else falls back to 3 and the run says so. Keep it small on big trees.",
      "example": "3",
      "input": {
        "label": "Max depth",
        "allow_custom": true
      }
    },
    {
      "name": "state_dir",
      "type": "string",
      "required": false,
      "default": "",
      "description": "Where to keep the baseline this play compares against. Leave empty to use the play's own run workspace. Nothing is ever written inside a repository either way.",
      "example": "~/.rote/sweep-git-repos-state",
      "input": {
        "label": "State dir",
        "allow_custom": true
      }
    },
    {
      "name": "emails",
      "type": "string",
      "required": false,
      "default": "",
      "description": "Extra addresses that count as yours, comma separated. Your repo-level and global git user.email already count; this is for the other addresses you commit under.",
      "example": "you@work.com, you@users.noreply.github.com",
      "input": {
        "label": "Emails",
        "allow_custom": true
      }
    },
    {
      "name": "only",
      "type": "string",
      "required": false,
      "default": "",
      "description": "Sweep only the repositories whose path under base_dir contains this text, case-insensitive. The baseline still records everything found, so a filtered run cannot make the next full run think the rest disappeared.",
      "example": "api",
      "input": {
        "label": "Only",
        "allow_custom": true
      }
    },
    {
      "name": "max_repos",
      "type": "string",
      "required": false,
      "default": "0",
      "description": "Stop after this many repositories, in path order. 0 means no cap. Must be a whole number; anything else is ignored as no cap and the run says so.",
      "example": "20",
      "input": {
        "label": "Max repos",
        "allow_custom": true
      }
    },
    {
      "name": "format",
      "type": "string",
      "required": false,
      "default": "text",
      "description": "How the briefing reads. The value text is the aligned terminal view, markdown a table you can paste into a document, json the same object the result view carries.",
      "example": "markdown",
      "valid_values": [
        "text",
        "markdown",
        "json"
      ],
      "input": {
        "label": "Format",
        "allow_custom": false,
        "choices": [
          {
            "label": "text",
            "value": "text"
          },
          {
            "label": "markdown",
            "value": "markdown"
          },
          {
            "label": "json",
            "value": "json"
          }
        ]
      }
    },
    {
      "name": "github",
      "type": "string",
      "required": false,
      "default": "auto",
      "description": "Which route checks unpushed and upstream-less branches. The value auto tries the gh CLI, then the rote github adapter, then skips and says why. The values gh and adapter each insist on one. The value never keeps the sweep local. No token is needed to run; without one the leg is skipped and the receipt prints the rote token set command that enables it. GET only.",
      "example": "adapter",
      "valid_values": [
        "auto",
        "gh",
        "adapter",
        "never"
      ],
      "input": {
        "label": "Github",
        "allow_custom": false,
        "choices": [
          {
            "label": "auto",
            "value": "auto"
          },
          {
            "label": "gh",
            "value": "gh"
          },
          {
            "label": "adapter",
            "value": "adapter"
          },
          {
            "label": "never",
            "value": "never"
          }
        ]
      }
    },
    {
      "name": "webhook_url",
      "type": "string",
      "required": false,
      "default": "",
      "description": "Where to post the run digest. Leave empty and no socket is opened at all. An https URL is posted to; plain http is refused unless it is loopback, which is how the packaged test proves delivery without leaving the machine. A webhook that is down is reported, never allowed to lose the sweep.",
      "example": "https://hooks.slack.com/services/T000/B000/xxxx",
      "input": {
        "label": "Webhook url",
        "allow_custom": true
      }
    }
